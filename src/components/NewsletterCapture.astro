---
interface Props {
  id?: string;
  heading?: string;
  subtitle?: string;
  badge?: string;
}

const {
  id = 'newsletter',
  heading = "Get Luke's Executive Audio Briefings & Teardowns",
  subtitle = "Direct financial analysis, unvarnished accounting autopsies, and podcast episode drops delivered to your inbox. The foundational tier for upcoming subscriber research and model access.",
  badge = "Executive Subscriptions",
} = Astro.props;

const inputId = `${id}-email`;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const titleId = `${id}-title`;
---

<section class="subscription-section" aria-labelledby={titleId}>
  <div class="subscription-card">
    <div class="subscription-header">
      <div class="subscription-badge">
        <span aria-hidden="true">📬</span>
        <span>{badge}</span>
      </div>
      <h2 id={titleId} class="subscription-title">{heading}</h2>
      <p class="subscription-description">{subtitle}</p>
    </div>

    <!-- Foundational Subscription Tiers Preview -->
    <div class="subscription-tiers" role="region" aria-label="Subscription tiers">
      <div class="tier-box is-active">
        <div class="tier-top">
          <span class="tier-pill">Current Access</span>
          <h3 class="tier-title">Executive Briefing (Free)</h3>
        </div>
        <p class="tier-detail">
          Full essays, audio debates, public financial analyses, and new episode drop notifications.
        </p>
      </div>

      <div class="tier-box tier-future">
        <div class="tier-top">
          <span class="tier-pill tier-pill-future">Coming Soon</span>
          <h3 class="tier-title">Subscriber Intelligence (Pro)</h3>
        </div>
        <p class="tier-detail">
          Downloadable Excel/DCF models, member-only audio debriefs, and private research notes.
        </p>
      </div>
    </div>

    <!-- Capture Form (Semantic & Accessible per html-contract.md) -->
    <form class="subscription-form" action="/api/subscribe" method="post" novalidate>
      <div class="field subscription-field">
        <label for={inputId} class="subscription-label">Enter your work or personal email</label>
        <div class="subscription-input-group">
          <input
            id={inputId}
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="you@company.com"
            class="subscription-input"
            aria-describedby={`${hintId} ${errorId}`}
          />
          <button type="submit" class="subscription-button">
            <span>Subscribe to Briefings</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
        <p id={hintId} class="field-hint">
          Zero marketing spam. One-click unsubscribe anytime. Early priority access when Pro tiers launch.
        </p>
        <p id={errorId} class="field-error" role="alert" hidden>
          Please enter a valid email address.
        </p>
      </div>
      <div class="subscription-status sr-only" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script>
  function initSubscriptionForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.subscription-form');
    forms.forEach((form) => {
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
      const errorEl = form.querySelector<HTMLElement>('.field-error');
      const statusEl = form.querySelector<HTMLElement>('.subscription-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (!emailInput) return;

      emailInput.addEventListener('input', () => {
        if (errorEl) errorEl.hidden = true;
        emailInput.removeAttribute('aria-invalid');
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = emailInput.value.trim();
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!emailPattern.test(email)) {
          if (errorEl) {
            errorEl.hidden = false;
          }
          emailInput.setAttribute('aria-invalid', 'true');
          emailInput.focus();
          return;
        }

        if (errorEl) errorEl.hidden = true;
        emailInput.removeAttribute('aria-invalid');
        if (button) {
          button.disabled = true;
          button.textContent = 'Subscribing...';
        }

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          if (res.ok) {
            if (statusEl) {
              statusEl.textContent = 'Thank you! You are on the executive briefing list.';
              statusEl.className = 'subscription-status is-success';
            }
            emailInput.value = '';
            if (button) button.textContent = 'Subscribed ✓';
          } else {
            const errData = await res.json().catch(() => ({}));
            const msg = errData.message || 'Unable to complete subscription. Please try again.';
            if (statusEl) {
              statusEl.textContent = msg;
              statusEl.className = 'subscription-status is-error';
            }
            if (button) {
              button.disabled = false;
              button.innerHTML = '<span>Subscribe to Briefings</span> <span aria-hidden="true">→</span>';
            }
          }
        } catch (err) {
          if (statusEl) {
            statusEl.textContent = 'Network error. Please check your connection and try again.';
            statusEl.className = 'subscription-status is-error';
          }
          if (button) {
            button.disabled = false;
            button.innerHTML = '<span>Subscribe to Briefings</span> <span aria-hidden="true">→</span>';
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSubscriptionForms);
  } else {
    initSubscriptionForms();
  }
  document.addEventListener('astro:page-load', initSubscriptionForms);
</script>

<style>
  .subscription-section {
    margin: 4rem auto 2rem;
    max-width: 900px;
  }

  .subscription-card {
    background: linear-gradient(135deg, rgba(254, 247, 240, 0.95) 0%, rgba(255, 255, 255, 0.98) 100%);
    border: 2px solid rgba(234, 88, 12, 0.28);
    border-radius: 20px;
    padding: 2.75rem 2.5rem;
    box-shadow: 0 8px 30px var(--shadow-light);
    position: relative;
    overflow: hidden;
  }

  .subscription-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem;
  }

  .subscription-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(146, 64, 14, 0.1);
    color: var(--primary-brown);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
  }

  .subscription-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--dark-text);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .subscription-description {
    color: var(--light-text);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Foundational Tiers Preview */
  .subscription-tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .tier-box {
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    background: #ffffff;
    border: 1px solid var(--border-light);
    box-shadow: 0 2px 8px var(--shadow-light);
  }

  .tier-box.is-active {
    border-color: rgba(234, 88, 12, 0.4);
    background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(254, 247, 240, 0.6) 100%);
  }

  .tier-box.tier-future {
    border-style: dashed;
    border-color: rgba(148, 163, 184, 0.5);
    background: rgba(248, 250, 252, 0.7);
  }

  .tier-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tier-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    background: rgba(146, 64, 14, 0.12);
    color: var(--primary-brown);
  }

  .tier-pill-future {
    background: rgba(148, 163, 184, 0.2);
    color: var(--light-text);
  }

  .tier-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--dark-text);
    margin: 0;
  }

  .tier-detail {
    font-size: 0.85rem;
    color: var(--light-text);
    line-height: 1.5;
    margin: 0;
  }

  /* Form & Inputs */
  .subscription-form {
    max-width: 680px;
    margin: 0 auto;
  }

  .subscription-field {
    margin-bottom: 0.75rem;
  }

  .subscription-label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--dark-text);
    margin-bottom: 0.5rem;
  }

  .subscription-input-group {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
  }

  .subscription-input {
    flex: 1 1 auto;
    padding: 0.85rem 1.15rem;
    border-radius: 10px;
    border: 1px solid var(--border-light);
    background: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--dark-text);
    box-shadow: 0 2px 6px var(--shadow-light);
    transition: all 0.2s ease;
  }

  .subscription-input:focus {
    outline: none;
    border-color: var(--accent-amber);
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.18);
  }

  .subscription-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.65rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--primary-brown), var(--accent-amber));
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 12px rgba(146, 64, 14, 0.25);
    transition: all 0.25s ease;
  }

  .subscription-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.35);
  }

  .subscription-button:disabled {
    opacity: 0.75;
    cursor: not-allowed;
    transform: none;
  }

  .field-hint {
    font-size: 0.8rem;
    color: var(--light-text);
    margin-top: 0.6rem;
    margin-bottom: 0;
  }

  .field-error {
    font-size: 0.82rem;
    color: #b91c1c;
    font-weight: 600;
    margin-top: 0.4rem;
    margin-bottom: 0;
  }

  .subscription-status.is-success {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(34, 197, 94, 0.12);
    color: #15803d;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
  }

  .subscription-status.is-error {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(239, 68, 68, 0.12);
    color: #b91c1c;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .subscription-card {
      padding: 1.75rem 1.25rem;
    }

    .subscription-title {
      font-size: 1.45rem;
    }

    .subscription-tiers {
      grid-template-columns: 1fr;
    }

    .subscription-input-group {
      flex-direction: column;
    }

    .subscription-button {
      justify-content: center;
    }
  }
</style>
