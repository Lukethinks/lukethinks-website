---
// Article/research page: the podcast episodes that accompany this piece (reverse of an
// episode's `related` field). Renders nothing when there are none.
import { getEpisodesFor } from '../../utils/episodes';

interface Props {
  slug: string;
}

const episodes = await getEpisodesFor(Astro.props.slug);
---

{episodes.length > 0 && (
  <aside class="related-episodes" aria-labelledby="related-episodes-heading">
    <h2 class="related-episodes-heading" id="related-episodes-heading">Podcast episodes on this piece</h2>
    <ul class="related-episodes-list">
      {episodes.map((ep) => (
        <li class="related-episode">
          <a class="related-episode-link" href={ep.href}>{ep.title}</a>
          <span class="related-episode-meta">
            Episode {ep.episode} · {ep.formatLabel} · {ep.durationLabel}
          </span>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-episodes {
    margin: -2rem 0 3rem;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background: var(--surface-card-translucent);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--accent-amber);
  }

  .related-episodes-heading {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--light-text);
  }

  .related-episodes-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-episode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    margin: 0;
  }

  .related-episode-link {
    font-weight: 700;
    color: var(--dark-text);
  }

  .related-episode-link:hover {
    color: var(--accent-amber);
  }

  .related-episode-meta {
    font-size: 0.82rem;
    color: var(--light-text);
  }
</style>
