---
interface Props {
  episode: {
    data: {
      title: string;
      slug: string;
      summary: string;
      published: Date | string;
      episode: number;
      season?: number;
      tags?: string[];
      confidence?: string;
      audio: {
        src: string;
        bytes: number;
        durationSeconds: number;
        mimeType?: string;
      };
      production?: {
        source?: string;
        aiDisclosed?: boolean;
      };
    };
  };
  takeaways?: string[];
  companionArticle?: { title: string; href: string };
}

const { episode, takeaways = [], companionArticle } = Astro.props;
const { data } = episode;

const durationMinutes = Math.ceil(data.audio.durationSeconds / 60);
const publishedDate = new Date(data.published);
const publishedIso = publishedDate.toISOString().slice(0, 10);
const pubDateHuman = publishedDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const epNumPadded = String(data.episode).padStart(2, '0');
const isDebate = data.title.toLowerCase().includes('debate') || data.audio.src.toLowerCase().includes('debate');
const format = isDebate ? 'debate' : 'briefing';
const formatLabel = isDebate ? 'Point · Counterpoint' : 'Executive Briefing';
---

<article
  class="episode-card"
  data-slug={data.slug}
  data-episode={data.episode}
  data-format={format}
  data-tags={(data.tags ?? []).join(' ').toLowerCase()}
  data-title={data.title.toLowerCase()}
  data-summary={data.summary.toLowerCase()}
  data-takeaways={takeaways.join(' ').toLowerCase()}
>
  <!-- 1:1 Square Artwork / Episode Badge -->
  <div class="episode-card-art" aria-hidden="true">
    <div class="art-inner">
      <span class="art-icon">{isDebate ? '⚖️' : '🎙️'}</span>
      <span class="art-number">EP {epNumPadded}</span>
      <span class="art-label">{formatLabel}</span>
    </div>
  </div>

  <!-- Main Card Body -->
  <div class="episode-card-content">
    <div class="episode-card-header">
      <span class="episode-badge">Episode {data.episode}</span>
      <span class="episode-format-badge">{isDebate ? 'Debate' : 'Briefing'}</span>
      {data.season && <span class="episode-season">Season {data.season}</span>}
      <time datetime={publishedIso} class="episode-date">{pubDateHuman}</time>
      <span class="episode-duration">⏱️ {durationMinutes} min</span>
      {data.confidence && (
        <span class="confidence-badge" data-confidence={data.confidence}>
          {data.confidence}
        </span>
      )}
    </div>

    <h3 class="episode-title">
      <a href={`/podcast/${data.slug}`}>{data.title}</a>
    </h3>

    <p class="episode-summary">{data.summary}</p>

    {takeaways.length > 0 && (
      <div class="episode-takeaways">
        <h4 class="takeaways-heading">Key Takeaways & Discussion:</h4>
        <ul class="takeaways-list">
          {takeaways.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Streamlined Audio Action Trigger -->
    <div class="episode-player-action">
      <button
        type="button"
        class="episode-play-trigger"
        data-slug={data.slug}
        data-episode={data.episode}
        data-format={format}
        data-format-label={formatLabel}
        data-audio-src={data.audio.src}
        data-duration={durationMinutes}
        data-duration-seconds={data.audio.durationSeconds}
        data-title={data.title}
        aria-label={`Play Episode ${data.episode}: ${data.title}`}
      >
        <span class="play-trigger-icon" aria-hidden="true">▶</span>
        <span class="play-trigger-label">Play {formatLabel} ({durationMinutes} min)</span>
      </button>

      {data.production?.aiDisclosed && (
        <span class="ai-disclosure-badge">AI Disclosed</span>
      )}
    </div>

    <div class="episode-card-footer">
      <div class="footer-links-group">
        <a href={`/podcast/${data.slug}`} class="episode-notes-link">
          View Episode & Show Notes →
        </a>
        {companionArticle && (
          <a href={companionArticle.href} class="companion-article-link">
            📖 Read Full Essay: {companionArticle.title}
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  function initEpisodeCardTriggers() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.episode-play-trigger');
    triggers.forEach((btn) => {
      if (btn.dataset.initialized === 'true') return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        const audioSrc = btn.dataset.audioSrc;
        const durationMinutes = parseInt(btn.dataset.duration || '0', 10);
        const durationSeconds = parseInt(btn.dataset.durationSeconds || '0', 10);
        const episodeNumber = btn.dataset.episode;
        const formatLabel = btn.dataset.formatLabel;

        const isPlaying = btn.classList.contains('is-playing');
        if (isPlaying) {
          const globalPlayPause = document.getElementById('global-play-pause-btn');
          if (globalPlayPause) {
            globalPlayPause.click();
          }
        } else {
          window.dispatchEvent(
            new CustomEvent('lukethinks:dock-audio', {
              detail: {
                slug,
                title,
                audioSrc,
                durationMinutes,
                durationSeconds,
                episodeNumber,
                format: formatLabel,
              },
              bubbles: true,
            })
          );
        }
      });
    });

    window.addEventListener('lukethinks:audio-state-change', (e: Event) => {
      const customEvent = e as CustomEvent;
      const { slug, isPlaying } = customEvent.detail || {};

      triggers.forEach((btn) => {
        const btnSlug = btn.dataset.slug;
        const icon = btn.querySelector('.play-trigger-icon');
        const label = btn.querySelector('.play-trigger-label');
        const formatLabel = btn.dataset.formatLabel || 'Briefing';
        const duration = btn.dataset.duration || '0';
        const card = btn.closest('.episode-card');

        if (btnSlug === slug && isPlaying) {
          btn.classList.add('is-playing');
          card?.classList.add('is-playing');
          if (icon) icon.textContent = '⏸';
          if (label) label.textContent = `Pause ${formatLabel}`;
        } else {
          btn.classList.remove('is-playing');
          card?.classList.remove('is-playing');
          if (icon) icon.textContent = '▶';
          if (label) label.textContent = `Play ${formatLabel} (${duration} min)`;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEpisodeCardTriggers);
  } else {
    initEpisodeCardTriggers();
  }
  document.addEventListener('astro:page-load', initEpisodeCardTriggers);
</script>

<style>
  .episode-card {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    background: var(--surface-card);
    border-radius: 20px;
    padding: 2.25rem;
    border: 1px solid var(--border-light);
    box-shadow: 0 4px 20px var(--shadow-light);
    transition: all 0.3s ease;
    align-items: flex-start;
  }

  .episode-card:hover {
    box-shadow: 0 8px 30px var(--shadow-medium);
    border-color: var(--accent-amber);
    transform: translateY(-2px);
  }

  .episode-card.is-playing {
    border-color: var(--accent-amber);
    box-shadow: 0 6px 24px var(--shadow-medium);
  }

  /* 1:1 Square Artwork Badge */
  .episode-card-art {
    flex: 0 0 170px;
    width: 170px;
    height: 170px;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--card-bg) 0%, var(--surface-footer) 60%, var(--primary-brown) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border-light);
    box-shadow: 0 8px 24px var(--shadow-medium);
    position: sticky;
    top: 6rem;
  }

  .art-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem;
    color: var(--cream);
  }

  .art-icon {
    font-size: 2.25rem;
    margin-bottom: 0.35rem;
    line-height: 1;
  }

  .art-number {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--cream);
  }

  .art-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--light-amber);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  /* Main Content Area */
  .episode-card-content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .episode-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .episode-badge {
    background: rgba(146, 64, 14, 0.12);
    color: var(--primary-brown);
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.8rem;
  }

  .episode-format-badge {
    background: rgba(234, 88, 12, 0.12);
    color: var(--accent-amber);
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    font-size: 0.75rem;
  }

  .episode-season {
    color: var(--light-text);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .episode-date,
  .episode-duration {
    color: var(--light-text);
    font-weight: 500;
  }

  .episode-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--dark-text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .episode-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .episode-title a:hover {
    color: var(--accent-amber);
  }

  .episode-summary {
    color: var(--light-text);
    font-size: 0.98rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Takeaways Bullets */
  .episode-takeaways {
    background: rgba(146, 64, 14, 0.04);
    border-left: 3px solid var(--accent-amber);
    border-radius: 0 10px 10px 0;
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .takeaways-heading {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--dark-text);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .takeaways-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--medium-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .takeaways-list li {
    margin-bottom: 0.35rem;
  }

  .takeaways-list li:last-child {
    margin-bottom: 0;
  }

  /* Play Action Row */
  .episode-player-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
    padding: 0.75rem 0;
  }

  .episode-play-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--primary-brown);
    color: #ffffff;
    border: none;
    border-radius: 30px;
    padding: 0.65rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 2px 10px var(--shadow-light);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .episode-play-trigger:hover {
    background: var(--secondary-brown);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px var(--shadow-medium);
  }

  .episode-play-trigger.is-playing {
    background: var(--accent-amber);
    box-shadow: 0 4px 16px var(--shadow-medium);
  }

  .play-trigger-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .episode-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border-light);
    font-size: 0.9rem;
  }

  .footer-links-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .episode-notes-link {
    color: var(--accent-amber);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .episode-notes-link:hover {
    color: var(--primary-brown);
    text-decoration: underline;
  }

  .companion-article-link {
    color: var(--primary-brown);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .companion-article-link:hover {
    color: var(--accent-amber);
    text-decoration: underline;
  }

  .ai-disclosure-badge {
    font-size: 0.75rem;
    color: var(--light-text);
    background: var(--surface-button);
    border: 1px solid var(--border-light);
    padding: 0.25rem 0.65rem;
    border-radius: 12px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .episode-card {
      flex-direction: column;
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .episode-card-art {
      width: 100%;
      height: 120px;
      position: static;
      flex: 0 0 auto;
    }

    .art-inner {
      flex-direction: row;
      gap: 1rem;
    }

    .art-icon {
      font-size: 1.75rem;
      margin-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .episode-card,
    .episode-play-trigger {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
