---
// "What is new": the newest essays and episodes in one list, newest first.
import type { LatestItem } from '../../utils/latest';

interface Props {
  items: LatestItem[];
}

const { items } = Astro.props;
---

<ol class="latest-feed">
  {items.map((item, i) => (
    <li class="latest-feed-item">
      <p class="latest-feed-meta">
        <span class="latest-feed-kind" data-kind={item.kind.toLowerCase()}>{item.kind}</span>
        {i === 0 && <span class="latest-feed-new">Newest</span>}
        <time datetime={item.publishedIso}>{item.publishedHuman}</time>
        <span aria-hidden="true">·</span>
        <span>{item.meta}</span>
      </p>
      <h3 class="latest-feed-title"><a href={item.href}>{item.title}</a></h3>
      <p class="latest-feed-summary">{item.summary}</p>
    </li>
  ))}
</ol>

<style>
  .latest-feed {
    max-width: 860px;
    margin: 0 auto 1rem;
    padding: 0 1.75rem;
    list-style: none;
    border-radius: 16px;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    box-shadow: 0 4px 16px var(--shadow-light);
  }

  .latest-feed-item {
    margin: 0;
    padding: 1.4rem 0;
    border-top: 1px solid var(--border-light);
  }

  .latest-feed-item:first-child {
    border-top: 0;
  }

  .latest-feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    color: var(--light-text);
  }

  .latest-feed-kind {
    padding: 0.1rem 0.6rem;
    border-radius: 8px;
    background: rgba(146, 64, 14, 0.1);
    color: var(--primary-brown);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .latest-feed-new {
    padding: 0.1rem 0.6rem;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--primary-brown), var(--accent-amber));
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .latest-feed-title {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .latest-feed-title a {
    color: var(--dark-text);
    text-decoration: none;
  }

  .latest-feed-title a:hover {
    color: var(--accent-amber);
  }

  .latest-feed-summary {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--light-text);
  }

  @media (max-width: 768px) {
    .latest-feed {
      padding: 0 1.1rem;
    }
  }
</style>
