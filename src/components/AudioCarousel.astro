---
import AudioPlayer from './AudioPlayer.astro';
import { resolveAudioUrl } from '../utils/audio';

export interface CarouselItem {
  id: string;
  slug: string;
  title: string;
  summary: string;
  published: Date | string;
  episodeNumber?: number;
  season?: number;
  format?: 'briefing' | 'debate' | 'narration' | 'summary' | string;
  tags?: string[];
  confidence?: 'low' | 'medium' | 'high' | string;
  audio: {
    src: string;
    bytes: number;
    durationSeconds: number;
    mimeType?: string;
  };
  takeaways?: string[];
  companionArticle?: {
    title: string;
    href: string;
  };
  production?: {
    source?: string;
    aiDisclosed?: boolean;
  };
  isSeries?: boolean;
  series?: string;
  seriesPart?: number;
  partsCount?: number;
  theme?: string;
  episodes?: CarouselItem[];
}

export interface Props {
  id?: string;
  items: CarouselItem[];
  title?: string;
  subtitle?: string;
  initialIndex?: number;
  defaultView?: 'carousel' | 'grid';
  showDockedPlayer?: boolean;
  dockedHeadingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  id = 'audio-carousel',
  items = [],
  title = 'Featured Audio & Episodes',
  subtitle = 'Browse executive briefings and debates.',
  initialIndex = 0,
  defaultView = 'carousel',
  showDockedPlayer = true,
  dockedHeadingLevel = 'h3',
  class: className = '',
} = Astro.props;

const totalItems = items.length;
const safeInitialIndex = totalItems > 0 ? Math.max(0, Math.min(totalItems - 1, initialIndex)) : 0;
const initialItem = items[safeInitialIndex];
const initialIsSeries = Boolean(initialItem && (initialItem.isSeries || (initialItem.episodes && initialItem.episodes.length > 0)));
const initialFirstEp = initialIsSeries && initialItem?.episodes && initialItem.episodes.length > 0 ? initialItem.episodes[0] : initialItem;
const initialResolvedAudio = initialFirstEp ? resolveAudioUrl(initialFirstEp.audio.src) : '';
const initialTitle = initialIsSeries && initialFirstEp
  ? (initialFirstEp.seriesPart ? `Play Part ${initialFirstEp.seriesPart}: ${initialFirstEp.title}` : `Play Episode ${String(initialFirstEp.episodeNumber ?? 1).padStart(2, '0')}: ${initialFirstEp.title}`)
  : (initialItem ? `Play Episode ${String(initialItem.episodeNumber ?? 1).padStart(2, '0')}: ${initialItem.title}` : '');
const initialDurationSeconds = initialFirstEp ? initialFirstEp.audio.durationSeconds : (initialItem ? initialItem.audio.durationSeconds : 0);
const initialVariant = initialIsSeries ? 'series' : (initialItem?.format || 'episode');

const containerId = id;
const announcerId = `${id}-announcer`;
const trackId = `${id}-track`;
const seriesDrawerId = `${id}-series-drawer`;
const dockedPlayerId = `${id}-docked-player`;
const dockedHeadingId = `${id}-docked-heading`;
const dockedStationId = `${id}-docked-station`;

const seriesItems = items.filter((it) => Boolean(it.isSeries || (it.episodes && it.episodes.length > 0)));
const hasSeries = seriesItems.length > 0;
---

<section
  class={`audio-carousel-container ${defaultView === 'grid' ? 'is-grid-view' : 'is-carousel-view'} ${className}`.trim()}
  id={containerId}
  data-component="audio-carousel"
  data-initial-index={safeInitialIndex}
  data-total-items={totalItems}
  role="region"
  aria-roledescription="carousel"
  aria-label={title}
>
  <!-- Screen reader live announcer -->
  <div class="sr-only" aria-live="polite" aria-atomic="true" id={announcerId}>
    {initialItem ? `Slide 1 of ${totalItems}: ${initialItem.title}` : 'No episodes available'}
  </div>

  <!-- Carousel Header & Mode Toolbar -->
  <div class="carousel-header">
    <div class="carousel-title-group">
      <h2 class="carousel-section-title">{title}</h2>
      {subtitle && <p class="carousel-section-subtitle">{subtitle}</p>}
    </div>

    {totalItems > 0 && (
      <div class="carousel-toolbar" role="toolbar" aria-label="Carousel navigation and view controls">
        <div class="carousel-track-counter" aria-hidden="true">
          <span class="track-indicator">
            <span class="current-track-num">{safeInitialIndex + 1}</span> of <span class="total-tracks-num">{totalItems}</span>
          </span>
        </div>

        <div class="view-mode-toggle" role="group" aria-label="Catalog view mode">
          <button
            type="button"
            class={`view-btn ${defaultView === 'carousel' ? 'is-active' : ''}`}
            data-view="carousel"
            aria-pressed={defaultView === 'carousel' ? 'true' : 'false'}
            aria-label="Switch to carousel view"
          >
            <span class="view-btn-icon" aria-hidden="true">🎛️</span>
            <span class="view-btn-label">Carousel</span>
          </button>
          <button
            type="button"
            class={`view-btn ${defaultView === 'grid' ? 'is-active' : ''}`}
            data-view="grid"
            aria-pressed={defaultView === 'grid' ? 'true' : 'false'}
            aria-label="Switch to responsive grid view"
          >
            <span class="view-btn-icon" aria-hidden="true">▦</span>
            <span class="view-btn-label">Grid View</span>
          </button>
        </div>
      </div>
    )}
  </div>

  {totalItems === 0 ? (
    <div class="empty-state">
      <p>No audio episodes available in catalog.</p>
    </div>
  ) : (
    <>
      <!-- Carousel Stage Viewport -->
      <div class="audio-carousel-stage">
        <!-- Edge Stepper Buttons -->
        <button
          type="button"
          class="carousel-stepper-btn prev-btn"
          aria-label="Previous episode"
          aria-controls={trackId}
          disabled={safeInitialIndex === 0}
        >
          <span class="stepper-icon" aria-hidden="true">‹</span>
        </button>

        <button
          type="button"
          class="carousel-stepper-btn next-btn"
          aria-label="Next episode"
          aria-controls={trackId}
          disabled={safeInitialIndex >= totalItems - 1}
        >
          <span class="stepper-icon" aria-hidden="true">›</span>
        </button>

        <!-- Horizontal Scroller Track -->
        <div
          class="carousel-track"
          id={trackId}
          role="group"
          aria-label="Episode slides"
          tabindex="0"
        >
          {items.map((item, idx) => {
            const isInitial = idx === safeInitialIndex;
            const isFocusable = isInitial || defaultView === 'grid';
            const childTabIndex = isFocusable ? '0' : '-1';
            const isInert = !isInitial && defaultView !== 'grid';
            const isSeries = Boolean(item.isSeries || (item.episodes && item.episodes.length > 0));
            const partsCount = item.partsCount ?? item.episodes?.length ?? 1;
            const seriesTheme = item.theme ?? '';
            const epNum = item.episodeNumber ?? (idx + 1);
            const epNumPadded = String(epNum).padStart(2, '0');
            const durationMin = Math.ceil(item.audio.durationSeconds / 60);
            const pubDate = new Date(item.published);
            const pubDateHuman = pubDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            });
            const isDebate = (item.format === 'debate') || item.title.toLowerCase().includes('debate');
            const formatLabel = isSeries ? 'Curated Series' : (isDebate ? 'Point · Counterpoint' : 'Executive Briefing');
            const resolvedSrc = resolveAudioUrl(item.audio.src);
            const firstEpSlug = item.episodes?.[0]?.slug || item.slug;
            const firstAudioSrc = item.episodes?.[0]?.audio?.src ? resolveAudioUrl(item.episodes[0].audio.src) : resolvedSrc;
            const firstDurationMin = item.episodes?.[0]?.audio?.durationSeconds ? Math.ceil(item.episodes[0].audio.durationSeconds / 60) : durationMin;

            let initialFlankClass = '';
            if (isInitial) {
              initialFlankClass = 'is-active';
            } else if (idx === safeInitialIndex - 1) {
              initialFlankClass = 'is-prev';
            } else if (idx < safeInitialIndex - 1) {
              initialFlankClass = 'is-far-prev';
            } else if (idx === safeInitialIndex + 1) {
              initialFlankClass = 'is-next';
            } else {
              initialFlankClass = 'is-far-next';
            }

            return (
              <article
                class={`carousel-item ${initialFlankClass}`.trim()}
                role="group"
                aria-roledescription="slide"
                aria-label={isSeries ? `Series ${idx + 1} of ${totalItems}: ${item.title} (${partsCount} Parts)` : `Episode ${idx + 1} of ${totalItems}: ${item.title}`}
                data-index={idx}
                data-slug={item.slug}
                data-title={item.title}
                data-episode={epNumPadded}
                data-format={item.format || (isSeries ? 'series' : (isDebate ? 'debate' : 'briefing'))}
                data-format-label={formatLabel}
                data-audio-src={resolvedSrc}
                data-duration={durationMin}
                data-duration-seconds={item.audio.durationSeconds}
                data-companion-href={item.companionArticle?.href || ''}
                data-companion-title={item.companionArticle?.title || ''}
                data-is-series={isSeries ? 'true' : 'false'}
                data-parts-count={isSeries ? partsCount : undefined}
                data-series-title={isSeries ? item.title : undefined}
                tabindex={isFocusable ? '0' : '-1'}
                aria-current={isInitial ? 'true' : undefined}
                aria-haspopup={isSeries ? 'true' : undefined}
                aria-expanded={isSeries ? 'false' : undefined}
                inert={isInert ? true : undefined}
              >
                <div class="carousel-card-inner">
                  <!-- 1:1 Square Artwork Badge with Floor Reflection -->
                  <div class="carousel-card-artwork" aria-hidden="true">
                    <div class="artwork-inner">
                      <span class="artwork-icon">{isSeries ? '📚' : (isDebate ? '⚖️' : '🎙️')}</span>
                      <span class="artwork-number">{isSeries ? `${partsCount} PARTS` : `EP ${epNumPadded}`}</span>
                      <span class="artwork-label">{isSeries ? 'Series' : formatLabel}</span>
                    </div>
                  </div>

                  <!-- Card Editorial Content -->
                  <div class="carousel-card-content">
                    <div class="carousel-card-meta">
                      {isSeries ? (
                        <>
                          <span class="carousel-badge carousel-parts-count">{partsCount} Parts</span>
                          <span class="carousel-format-badge carousel-series-badge">Series</span>
                          {seriesTheme && <span class="carousel-theme-tag">{seriesTheme}</span>}
                        </>
                      ) : (
                        <>
                          <span class="carousel-badge">EP {epNumPadded}</span>
                          <span class="carousel-format-badge">{isDebate ? 'Debate' : 'Briefing'}</span>
                          <time datetime={pubDate.toISOString().slice(0, 10)} class="carousel-date">{pubDateHuman}</time>
                          <span class="carousel-duration">⏱️ {durationMin} min</span>
                          {item.confidence && (
                            <span class="carousel-confidence">
                              {item.confidence}
                            </span>
                          )}
                        </>
                      )}
                    </div>

                    <h3 class="carousel-card-title">
                      {isSeries ? (
                        <span class="carousel-series-title">{item.title}</span>
                      ) : (
                        <a
                          href={`/podcast/${item.slug}`}
                          class="carousel-title-link"
                          tabindex={childTabIndex}
                        >
                          {item.title}
                        </a>
                      )}
                    </h3>

                    <p class="carousel-card-summary">{item.summary}</p>

                    {item.takeaways && item.takeaways.length > 0 && (
                      <div class="carousel-takeaways-preview">
                        <h4 class="takeaways-preview-heading">Key Takeaway:</h4>
                        <ul class="takeaways-preview-list">
                          <li>{item.takeaways[0]}</li>
                        </ul>
                      </div>
                    )}

                    <!-- Card Actions -->
                    <div class="carousel-card-actions">
                      {isSeries ? (
                        <>
                          <button
                            type="button"
                            class="carousel-series-toggle-btn"
                            data-index={idx}
                            data-series-slug={item.slug}
                            aria-expanded="false"
                            aria-controls={seriesDrawerId}
                            aria-label={`Explore ${item.title} series (${partsCount} parts)`}
                            tabindex={childTabIndex}
                          >
                            <span class="toggle-btn-icon" aria-hidden="true">▾</span>
                            <span class="toggle-btn-text">Explore Series ({partsCount} Parts)</span>
                          </button>
                          <button
                            type="button"
                            class="carousel-play-btn series-quick-play-btn"
                            data-index={idx}
                            data-slug={firstEpSlug}
                            data-audio-src={firstAudioSrc}
                            data-title={item.episodes?.[0]?.title || item.title}
                            data-duration={firstDurationMin}
                            aria-label={`Play Part 1 of ${item.title}`}
                            tabindex={childTabIndex}
                          >
                            <span class="play-btn-icon" aria-hidden="true">▶</span>
                            <span class="play-btn-text">Play Part 1</span>
                          </button>
                        </>
                      ) : (
                        <>
                          <button
                            type="button"
                            class="carousel-play-btn"
                            data-index={idx}
                            data-slug={item.slug}
                            data-audio-src={resolvedSrc}
                            data-title={item.title}
                            data-duration={durationMin}
                            aria-label={`Play Episode ${epNumPadded}: ${item.title}`}
                            tabindex={childTabIndex}
                          >
                            <span class="play-btn-icon" aria-hidden="true">▶</span>
                            <span class="play-btn-text">Listen</span>
                          </button>

                          <a
                            href={`/podcast/${item.slug}`}
                            class="carousel-detail-link"
                            tabindex={childTabIndex}
                          >
                            Show Notes →
                          </a>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- In-Place Expandable Series Drawer -->
      {hasSeries && (
        <div
          class="carousel-series-drawer is-collapsed"
          id={seriesDrawerId}
          role="region"
          aria-label="Series episode tracklist"
          aria-hidden="true"
        >
          {seriesItems.map((series, sIdx) => {
            const eps = [...(series.episodes || [])].sort((a, b) => {
              const partA = a.seriesPart ?? a.episodeNumber ?? (a as any).episode ?? 0;
              const partB = b.seriesPart ?? b.episodeNumber ?? (b as any).episode ?? 0;
              if (partA !== partB) return partA - partB;
              const dateA = a.published ? new Date(a.published).getTime() : 0;
              const dateB = b.published ? new Date(b.published).getTime() : 0;
              if (dateA !== dateB) return dateA - dateB;
              return (a.slug || '').localeCompare(b.slug || '');
            });
            const isInitialSeries = sIdx === 0;
            const partsTotal = eps.length;

            return (
              <div
                class={`drawer-series-content ${isInitialSeries ? 'is-active' : ''}`}
                data-series-index={items.indexOf(series)}
                data-series-slug={series.slug}
                id={`${id}-drawer-content-${series.slug}`}
              >
                <div class="drawer-header">
                  <div class="drawer-title-group">
                    <div class="drawer-kicker-row">
                      <span class="drawer-kicker">Multi-Part Series Tracklist</span>
                      <span class="drawer-parts-count">{partsTotal} Parts · Intended Listening Sequence</span>
                    </div>
                    <h3 class="drawer-title">{series.title}</h3>
                    {series.theme && <p class="drawer-theme">{series.theme}</p>}
                  </div>
                  <button
                    type="button"
                    class="drawer-close-btn"
                    aria-label={`Collapse ${series.title} tracklist drawer`}
                    aria-controls={seriesDrawerId}
                  >
                    <span class="close-icon" aria-hidden="true">✕</span>
                    <span class="drawer-close-text">Collapse Drawer</span>
                  </button>
                </div>

                <ol class="drawer-tracklist" role="list">
                  {eps.map((ep, epIdx) => {
                    const partNum = ep.seriesPart ?? (epIdx + 1);
                    const epDurationMin = ep.audio?.durationSeconds ? Math.ceil(ep.audio.durationSeconds / 60) : 0;
                    const resolvedAudio = resolveAudioUrl(ep.audio?.src || '');
                    const isEpDebate = ep.format === 'debate' || ep.title.toLowerCase().includes('debate');
                    const epFormatBadge = isEpDebate ? 'Point · Counterpoint' : 'Executive Briefing';

                    return (
                      <li
                        class="drawer-episode-item"
                        data-slug={ep.slug}
                        data-part={partNum}
                        data-audio-src={resolvedAudio}
                        data-title={ep.title}
                        data-duration={epDurationMin}
                        data-duration-seconds={ep.audio?.durationSeconds || 0}
                        data-format-label={epFormatBadge}
                        data-episode={ep.episodeNumber ?? ep.episode ?? partNum}
                        tabindex="0"
                      >
                        <div class="drawer-episode-part">
                          <span class="part-label">PART</span>
                          <span class="part-number">{partNum}</span>
                        </div>

                        <div class="drawer-episode-main">
                          <div class="drawer-episode-header">
                            <h4 class="drawer-episode-title">
                              <a href={`/podcast/${ep.slug}`} class="drawer-episode-link">
                                {ep.title}
                              </a>
                            </h4>
                          </div>
                          <p class="drawer-episode-summary">{ep.summary}</p>
                          <div class="drawer-episode-meta">
                            <span class="drawer-format-badge">{epFormatBadge}</span>
                            <span class="drawer-duration">⏱️ {epDurationMin} min</span>
                            <a href={`/podcast/${ep.slug}`} class="drawer-notes-link">
                              Show Notes →
                            </a>
                          </div>
                        </div>

                        <div class="drawer-episode-actions">
                          <button
                            type="button"
                            class="drawer-play-btn carousel-play-btn"
                            data-slug={ep.slug}
                            data-part={partNum}
                            data-audio-src={resolvedAudio}
                            data-title={ep.title}
                            data-duration={epDurationMin}
                            data-duration-seconds={ep.audio?.durationSeconds || 0}
                            data-format-label={epFormatBadge}
                            data-episode={ep.episodeNumber ?? ep.episode ?? partNum}
                            aria-label={`Play Part ${partNum}: ${ep.title}`}
                          >
                            <span class="play-btn-icon" aria-hidden="true">▶</span>
                            <span class="play-btn-text">Play Part {partNum}</span>
                          </button>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </div>
            );
          })}
        </div>
      )}

      <!-- Docked Master Audio Player Section -->
      {showDockedPlayer && initialItem && (
        <section
          class="audio-docked-section has-docked-audio"
          id={dockedPlayerId}
          aria-labelledby={dockedHeadingId}
        >
          <div class="docked-section-header">
            <h3 id={dockedHeadingId} class="docked-title">
              <span class="docked-icon" aria-hidden="true">🎧</span>
              <span class="docked-title-text">Now Playing Station</span>
            </h3>
          </div>

          <div class="docked-player-wrapper">
            <AudioPlayer
              src={initialResolvedAudio}
              title={initialTitle}
              id={dockedStationId}
              durationSeconds={initialDurationSeconds}
              variant={initialVariant}
              headingLevel={dockedHeadingLevel}
              aiDisclosed={initialItem.production?.aiDisclosed}
              disclosureText="AI voices curated, directed and fact-checked by Luke."
            />
          </div>
        </section>
      )}
    </>
  )}
</section>

<!-- Noscript graceful degradation -->
<noscript>
  <style>
    .carousel-toolbar,
    .carousel-stepper-btn {
      display: none !important;
    }
    .audio-carousel-stage {
      perspective: none !important;
    }
    .carousel-track {
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
      gap: 2rem !important;
      overflow-x: visible !important;
      scroll-snap-type: none !important;
      padding: 1rem 0 !important;
    }
    .carousel-item {
      flex: initial !important;
      width: 100% !important;
      transform: none !important;
      opacity: 1 !important;
      outline: none !important;
      z-index: auto !important;
    }
    .carousel-card-artwork {
      -webkit-box-reflect: none !important;
    }
    .carousel-series-drawer,
    .carousel-series-drawer.is-collapsed,
    .drawer-series-content {
      display: block !important;
    }
    .drawer-close-btn {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { CarouselStateMachine, enforceExclusivePlayback } from '../utils/carousel-state';

  function initAudioCarousels() {
    const containers = document.querySelectorAll<HTMLElement>('.audio-carousel-container[data-component="audio-carousel"]');

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const containerId = container.id || 'audio-carousel';
      const track = container.querySelector<HTMLElement>('.carousel-track');
      const slides = Array.from(container.querySelectorAll<HTMLElement>('.carousel-item'));
      const prevBtn = container.querySelector<HTMLButtonElement>('.carousel-stepper-btn.prev-btn');
      const nextBtn = container.querySelector<HTMLButtonElement>('.carousel-stepper-btn.next-btn');
      const currentTrackNum = container.querySelector<HTMLElement>('.current-track-num');
      const announcer = container.querySelector<HTMLElement>(`#${containerId}-announcer`) ||
        container.querySelector<HTMLElement>('.sr-only[aria-live="polite"]');
      const viewButtons = container.querySelectorAll<HTMLButtonElement>('.view-btn');
      const dockedSection = container.querySelector<HTMLElement>(`#${containerId}-docked-player`) ||
        container.querySelector<HTMLElement>('.audio-docked-section');
      const playButtons = container.querySelectorAll<HTMLButtonElement>('.carousel-play-btn:not(.drawer-play-btn):not(.series-quick-play-btn)');
      const seriesDrawer = container.querySelector<HTMLElement>(`#${containerId}-series-drawer`) ||
        container.querySelector<HTMLElement>('.carousel-series-drawer');
      const seriesToggleButtons = container.querySelectorAll<HTMLButtonElement>('.carousel-series-toggle-btn');
      const drawerCloseButtons = container.querySelectorAll<HTMLButtonElement>('.drawer-close-btn');
      const drawerPlayButtons = container.querySelectorAll<HTMLButtonElement>('.drawer-play-btn');
      const drawerEpisodeItems = container.querySelectorAll<HTMLElement>('.drawer-episode-item');

      if (!track || slides.length === 0) return;

      const itemsData = slides.map((slide, idx) => {
        const isSeries = slide.dataset.isSeries === 'true';
        let episodes: any[] | undefined = undefined;
        if (isSeries && seriesDrawer) {
          const content = seriesDrawer.querySelector<HTMLElement>(
            `.drawer-series-content[data-series-index="${idx}"], .drawer-series-content[data-series-slug="${slide.dataset.slug}"]`
          );
          if (content) {
            episodes = Array.from(content.querySelectorAll<HTMLElement>('.drawer-episode-item')).map((epItem) => ({
              slug: epItem.dataset.slug || '',
              title: epItem.dataset.title || '',
              seriesPart: parseInt(epItem.dataset.part || '1', 10),
              format: epItem.dataset.formatLabel || '',
              audio: {
                src: epItem.dataset.audioSrc || '',
                durationSeconds: parseInt(epItem.dataset.durationSeconds || '0', 10),
              },
            }));
          }
        }
        return {
          slug: slide.dataset.slug || '',
          title: slide.dataset.title || '',
          episodeNumber: parseInt(slide.dataset.episode || String(idx + 1), 10),
          format: slide.dataset.format || '',
          isSeries,
          partsCount: slide.dataset.partsCount ? parseInt(slide.dataset.partsCount, 10) : undefined,
          series: slide.dataset.seriesTitle,
          episodes,
          audio: {
            src: slide.dataset.audioSrc || '',
            durationSeconds: parseInt(slide.dataset.durationSeconds || '0', 10),
          },
        };
      });

      const stateMachine = new CarouselStateMachine(itemsData, {
        initialIndex: parseInt(container.dataset.initialIndex || '0', 10),
        defaultView: container.classList.contains('is-grid-view') ? 'grid' : 'carousel',
        prefersReducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      });

      let currentPlayingSlug: string | null = null;
      let isProgrammaticScroll = false;
      let scrollDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      // Locate docked player DOM elements
      function getDockedPlayerElements() {
        if (!dockedSection) return null;
        const audio = dockedSection.querySelector<HTMLAudioElement>('audio.custom-audio-player');
        const titleEl = dockedSection.querySelector<HTMLElement>('.audio-title');
        const variantEl = dockedSection.querySelector<HTMLElement>('.audio-variant-label');
        const timeEl = dockedSection.querySelector<HTMLElement>('.audio-meta time');
        const downloadLink = dockedSection.querySelector<HTMLAnchorElement>('.audio-download-action');
        return { audio, titleEl, variantEl, timeEl, downloadLink };
      }

      function updatePlayButtonUI(slide: HTMLElement, isPlaying: boolean, playingPart?: string | number) {
        const btn = slide.querySelector<HTMLButtonElement>('.carousel-play-btn');
        if (!btn) return;
        const isSeries = slide.dataset.isSeries === 'true';
        const icon = btn.querySelector<HTMLElement>('.play-btn-icon');
        const text = btn.querySelector<HTMLElement>('.play-btn-text');
        const ep = slide.dataset.episode || '';
        const t = slide.dataset.title || '';
        const partLabel = playingPart ? String(playingPart) : '1';

        btn.classList.toggle('is-playing', isPlaying);
        btn.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');

        if (isPlaying) {
          if (isSeries) {
            btn.setAttribute('aria-label', `Pause Part ${partLabel} of ${t}`);
            if (icon) icon.textContent = '⏸';
            if (text) text.textContent = partLabel === '1' ? 'Pause Part 1' : `Pause Part ${partLabel}`;
          } else {
            btn.setAttribute('aria-label', `Pause Episode ${ep}: ${t}`);
            if (icon) icon.textContent = '⏸';
            if (text) text.textContent = 'Pause';
          }
        } else {
          if (isSeries) {
            const pausedPartLabel = playingPart ? String(playingPart) : '1';
            btn.setAttribute('aria-label', `Play Part ${pausedPartLabel} of ${t}`);
            if (icon) icon.textContent = '▶';
            if (text) text.textContent = pausedPartLabel === '1' ? 'Play Part 1' : `Play Part ${pausedPartLabel}`;
          } else {
            btn.setAttribute('aria-label', `Play Episode ${ep}: ${t}`);
            if (icon) icon.textContent = '▶';
            if (text) text.textContent = 'Listen';
          }
        }
      }

      function syncPlaybackState(playingSlug: string | null, isPlaying: boolean) {
        stateMachine.isPlaying = isPlaying;

        let activeSeriesSlideIndex: number | null = null;
        let activePartNumber: string | number | undefined;

        const drawerItems = seriesDrawer ? Array.from(seriesDrawer.querySelectorAll<HTMLElement>('.drawer-episode-item')) : [];
        drawerItems.forEach((item) => {
          const isThis = Boolean(playingSlug && item.dataset.slug === playingSlug);
          item.classList.toggle('is-playing', isThis && isPlaying);
          item.classList.toggle('is-active', isThis);

          const pBtn = item.querySelector<HTMLButtonElement>('.drawer-play-btn');
          const pIcon = pBtn?.querySelector<HTMLElement>('.play-btn-icon');
          const pText = pBtn?.querySelector<HTMLElement>('.play-btn-text');
          const partNum = item.dataset.part || '';
          const title = item.dataset.title || '';

          if (isThis) {
            activePartNumber = partNum;
            const parentSeriesContent = item.closest<HTMLElement>('.drawer-series-content');
            if (parentSeriesContent?.dataset.seriesIndex) {
              activeSeriesSlideIndex = parseInt(parentSeriesContent.dataset.seriesIndex, 10);
            }
          }

          if (pBtn) {
            pBtn.classList.toggle('is-playing', isThis && isPlaying);
            pBtn.setAttribute('aria-pressed', isThis && isPlaying ? 'true' : 'false');
            if (isThis && isPlaying) {
              if (pIcon) pIcon.textContent = '⏸';
              if (pText) pText.textContent = `Pause Part ${partNum}`;
              pBtn.setAttribute('aria-label', `Pause Part ${partNum}: ${title}`);
            } else {
              if (pIcon) pIcon.textContent = '▶';
              if (pText) pText.textContent = `Play Part ${partNum}`;
              pBtn.setAttribute('aria-label', `Play Part ${partNum}: ${title}`);
            }
          }
        });

        slides.forEach((slide, idx) => {
          const isDirectMatch = Boolean(playingSlug && slide.dataset.slug === playingSlug);
          const isSeriesOwner = activeSeriesSlideIndex !== null && idx === activeSeriesSlideIndex;
          const isSlidePlaying = (isDirectMatch || isSeriesOwner) && isPlaying;
          const isSlideDocked = isDirectMatch || isSeriesOwner;

          slide.classList.toggle('is-playing', isSlidePlaying);
          slide.classList.toggle('is-docked', isSlideDocked);

          updatePlayButtonUI(slide, isSlidePlaying, isSeriesOwner ? activePartNumber : undefined);
        });
      }

      function expandDrawer(seriesIndex: number, focusFirst = false) {
        if (!seriesDrawer) return;
        const seriesSlide = slides[seriesIndex];
        if (!seriesSlide || seriesSlide.dataset.isSeries !== 'true') return;

        stateMachine.expandSeries(seriesIndex);

        seriesDrawer.classList.remove('is-collapsed');
        seriesDrawer.classList.add('is-expanded');
        seriesDrawer.setAttribute('aria-hidden', 'false');

        const seriesSlug = seriesSlide.dataset.slug || '';
        const allSeriesContents = seriesDrawer.querySelectorAll<HTMLElement>('.drawer-series-content');
        allSeriesContents.forEach((c) => {
          const isTarget = c.dataset.seriesIndex === String(seriesIndex) || c.dataset.seriesSlug === seriesSlug;
          c.classList.toggle('is-active', isTarget);
        });

        slides.forEach((s, idx) => {
          const toggleBtn = s.querySelector<HTMLButtonElement>('.carousel-series-toggle-btn');
          const isThis = idx === seriesIndex;
          if (toggleBtn) {
            toggleBtn.setAttribute('aria-expanded', isThis ? 'true' : 'false');
            toggleBtn.classList.toggle('is-expanded', isThis);
          }
          s.setAttribute('aria-expanded', isThis ? 'true' : 'false');
        });

        const sTitle = seriesSlide.dataset.seriesTitle || seriesSlide.dataset.title || '';
        const pCount = seriesSlide.dataset.partsCount || '3';
        if (announcer) {
          announcer.textContent = `Expanded series tracklist: ${sTitle}. ${pCount} parts available in intended listening sequence.`;
        }

        if (focusFirst) {
          const firstDrawerPlay = seriesDrawer.querySelector<HTMLElement>(
            '.drawer-series-content.is-active .drawer-play-btn'
          );
          firstDrawerPlay?.focus();
        }
      }

      function collapseDrawer(returnFocus = false) {
        if (!seriesDrawer) return;
        const prevIdx = stateMachine.expandedSeriesIndex;
        stateMachine.collapseSeries();

        seriesDrawer.classList.remove('is-expanded');
        seriesDrawer.classList.add('is-collapsed');
        seriesDrawer.setAttribute('aria-hidden', 'true');

        slides.forEach((s) => {
          const toggleBtn = s.querySelector<HTMLButtonElement>('.carousel-series-toggle-btn');
          if (toggleBtn) {
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.classList.remove('is-expanded');
          }
          s.setAttribute('aria-expanded', 'false');
        });

        if (announcer) {
          announcer.textContent = 'Series tracklist drawer collapsed.';
        }

        if (returnFocus && prevIdx !== null && slides[prevIdx]) {
          const triggerBtn = slides[prevIdx].querySelector<HTMLButtonElement>('.carousel-series-toggle-btn');
          if (triggerBtn) {
            triggerBtn.focus();
          } else {
            slides[prevIdx].focus();
          }
        }
      }

      function toggleDrawer(seriesIndex: number, focusFirst = false) {
        if (stateMachine.expandedSeriesIndex === seriesIndex) {
          collapseDrawer(false);
        } else {
          expandDrawer(seriesIndex, focusFirst);
        }
      }

      function updateSlideClasses(activeIndex: number) {
        const isGridView = stateMachine.viewMode === 'grid';

        slides.forEach((slide, idx) => {
          slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-far-prev', 'is-far-next');

          if (isGridView) {
            slide.setAttribute('tabindex', '0');
            slide.removeAttribute('inert');
            slide.removeAttribute('aria-current');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '0'));
            return;
          }

          if (idx === activeIndex) {
            slide.classList.add('is-active');
            slide.setAttribute('tabindex', '0');
            slide.setAttribute('aria-current', 'true');
            slide.removeAttribute('inert');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '0'));
          } else {
            slide.setAttribute('tabindex', '-1');
            slide.removeAttribute('aria-current');
            slide.setAttribute('inert', '');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '-1'));

            if (idx === activeIndex - 1) {
              slide.classList.add('is-prev');
            } else if (idx < activeIndex - 1) {
              slide.classList.add('is-far-prev');
            } else if (idx === activeIndex + 1) {
              slide.classList.add('is-next');
            } else {
              slide.classList.add('is-far-next');
            }
          }
        });

        // Update counter & steppers
        if (currentTrackNum) {
          currentTrackNum.textContent = String(activeIndex + 1);
        }

        if (prevBtn) prevBtn.disabled = activeIndex === 0;
        if (nextBtn) nextBtn.disabled = activeIndex >= slides.length - 1;

        // Screen reader announcement
        if (announcer && slides[activeIndex]) {
          const itemTitle = slides[activeIndex].dataset.title || '';
          announcer.textContent = `Slide ${activeIndex + 1} of ${slides.length}: ${itemTitle}`;
        }
      }

      function scrollToIndex(index: number, smooth = true) {
        if (!track || !slides[index]) return;
        isProgrammaticScroll = true;

        const slide = slides[index];
        const trackWidth = track.clientWidth;
        const slideWidth = slide.offsetWidth;
        const slideLeft = slide.offsetLeft;

        // Target center offset
        const targetScrollLeft = slideLeft - (trackWidth / 2) + (slideWidth / 2);

        track.scrollTo({
          left: Math.max(0, targetScrollLeft),
          behavior: smooth ? 'smooth' : 'auto',
        });

        setTimeout(() => {
          isProgrammaticScroll = false;
        }, smooth ? 450 : 50);
      }

      function goToSlide(index: number, focusCard = false) {
        const wasDrawerOpen = stateMachine.expandedSeriesIndex !== null;
        const clampedIndex = stateMachine.selectItem(index);
        updateSlideClasses(clampedIndex);

        if (wasDrawerOpen) {
          if (stateMachine.expandedSeriesIndex !== null) {
            expandDrawer(clampedIndex, false);
          } else {
            collapseDrawer(false);
          }
        }

        if (stateMachine.viewMode !== 'grid') {
          scrollToIndex(clampedIndex, true);
        }

        if (focusCard && slides[clampedIndex] && stateMachine.viewMode !== 'grid') {
          slides[clampedIndex].focus();
        }
      }

      function findCenterIndex(): number {
        if (!track) return stateMachine.activeIndex;
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        let closestIndex = 0;
        let minDistance = Infinity;

        slides.forEach((slide, idx) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const dist = Math.abs(slideCenter - trackCenter);
          if (dist < minDistance) {
            minDistance = dist;
            closestIndex = idx;
          }
        });

        return closestIndex;
      }

      function dockAndPlay(slide: HTMLElement, toggleIfSame = true) {
        const slug = slide.dataset.slug || '';
        const title = slide.dataset.title || '';
        const ep = slide.dataset.episode || '';
        const formatLabel = slide.dataset.formatLabel || '';
        const audioSrc = slide.dataset.audioSrc || '';
        const duration = slide.dataset.duration || '';

        const docked = getDockedPlayerElements();
        if (!docked || !docked.audio) return;

        if (toggleIfSame && currentPlayingSlug === slug) {
          if (docked.audio.paused) {
            docked.audio.play().catch(() => {});
          } else {
            docked.audio.pause();
          }
          return;
        }

        // Update player contents
        if (docked.titleEl) {
          docked.titleEl.textContent = `Play Episode ${ep}: ${title}`;
        }
        if (docked.variantEl && formatLabel) {
          docked.variantEl.textContent = formatLabel;
        }
        if (docked.timeEl && duration) {
          docked.timeEl.textContent = `${duration} min`;
        }
        if (docked.downloadLink && audioSrc) {
          docked.downloadLink.href = audioSrc;
          docked.downloadLink.setAttribute('aria-label', `Download MP3 for Episode ${ep}: ${title}`);
        }

        docked.audio.src = audioSrc;
        const sourceEl = docked.audio.querySelector<HTMLSourceElement>('source');
        if (sourceEl) {
          sourceEl.src = audioSrc;
        }
        docked.audio.setAttribute('aria-label', `Play Episode ${ep}: ${title}`);
        docked.audio.load();

        docked.audio.play().catch((err) => {
          console.log('Audio play triggered:', err);
        });

        currentPlayingSlug = slug;
        stateMachine.dockAndPlayActive();

        syncPlaybackState(currentPlayingSlug, true);

        // Dispatch decoupled event for observers
        window.dispatchEvent(
          new CustomEvent('lukethinks:dock-audio', {
            detail: {
              slug,
              title,
              episodeNumber: ep,
              format: formatLabel,
              audioSrc,
              durationMinutes: duration,
            },
            bubbles: true,
          })
        );
      }

      function switchView(mode: string | undefined) {
        const newMode = stateMachine.toggleView(mode as 'carousel' | 'grid');
        const isGridView = newMode === 'grid';
        if (isGridView) {
          container.classList.remove('is-carousel-view');
          container.classList.add('is-grid-view');
        } else {
          container.classList.remove('is-grid-view');
          container.classList.add('is-carousel-view');
        }

        viewButtons.forEach((btn) => {
          const isActive = btn.dataset.view === newMode;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });

        updateSlideClasses(stateMachine.activeIndex);
        if (!isGridView) {
          scrollToIndex(stateMachine.activeIndex, false);
        }
      }

      // Stepper button events
      prevBtn?.addEventListener('click', () => goToSlide(stateMachine.prev(), true));
      nextBtn?.addEventListener('click', () => goToSlide(stateMachine.next(), true));

      // View toggle buttons
      viewButtons.forEach((btn) => {
        btn.addEventListener('click', () => switchView(btn.dataset.view));
      });

      // Play button actions on slides
      playButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slide = btn.closest<HTMLElement>('.carousel-item');
          if (slide) dockAndPlay(slide, true);
        });
      });

      // Series toggle buttons on slides
      seriesToggleButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slide = btn.closest<HTMLElement>('.carousel-item');
          if (!slide) return;
          const idx = parseInt(slide.dataset.index || '0', 10);
          if (idx !== stateMachine.activeIndex) {
            goToSlide(idx, false);
          }
          toggleDrawer(idx, false);
        });
      });

      // Series quick play buttons on slides
      container.querySelectorAll<HTMLButtonElement>('.series-quick-play-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slide = btn.closest<HTMLElement>('.carousel-item');
          if (!slide) return;
          const idx = parseInt(slide.dataset.index || '0', 10);

          const docked = getDockedPlayerElements();
          const isThisSeriesActive = slide.classList.contains('is-docked') || slide.classList.contains('is-playing');

          if (isThisSeriesActive && docked?.audio && currentPlayingSlug) {
            if (docked.audio.paused) {
              docked.audio.play().catch(() => {});
            } else {
              docked.audio.pause();
            }
            return;
          }

          expandDrawer(idx, false);
          const firstDrawerPlay = seriesDrawer?.querySelector<HTMLButtonElement>(
            `.drawer-series-content[data-series-index="${idx}"] .drawer-play-btn`
          );
          if (firstDrawerPlay) {
            firstDrawerPlay.click();
          } else {
            dockAndPlay(slide, true);
          }
        });
      });

      // Drawer close buttons
      drawerCloseButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          collapseDrawer(true);
        });
      });

      // Drawer episode play buttons
      drawerPlayButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const epItem = btn.closest<HTMLElement>('.drawer-episode-item');
          if (!epItem) return;

          const slug = btn.dataset.slug || epItem.dataset.slug || '';
          const title = btn.dataset.title || epItem.dataset.title || '';
          const partNum = btn.dataset.part || epItem.dataset.part || '';
          const audioSrc = btn.dataset.audioSrc || epItem.dataset.audioSrc || '';
          const duration = btn.dataset.duration || epItem.dataset.duration || '';
          const formatLabel = btn.dataset.formatLabel || epItem.dataset.formatLabel || 'Series Episode';
          const epNumber = btn.dataset.episode || epItem.dataset.episode || partNum;

          const docked = getDockedPlayerElements();
          if (!docked || !docked.audio) return;

          if (currentPlayingSlug === slug) {
            if (docked.audio.paused) {
              docked.audio.play().catch(() => {});
            } else {
              docked.audio.pause();
            }
            return;
          }

          if (docked.titleEl) {
            docked.titleEl.textContent = `Play Part ${partNum}: ${title}`;
          }
          if (docked.variantEl) {
            docked.variantEl.textContent = formatLabel;
          }
          if (docked.timeEl && duration) {
            docked.timeEl.textContent = `${duration} min`;
          }
          if (docked.downloadLink && audioSrc) {
            docked.downloadLink.href = audioSrc;
            docked.downloadLink.setAttribute('aria-label', `Download MP3 for Part ${partNum}: ${title}`);
          }

          docked.audio.src = audioSrc;
          const sourceEl = docked.audio.querySelector<HTMLSourceElement>('source');
          if (sourceEl) sourceEl.src = audioSrc;
          docked.audio.setAttribute('aria-label', `Play Part ${partNum}: ${title}`);
          docked.audio.load();
          docked.audio.play().catch(() => {});

          currentPlayingSlug = slug;
          stateMachine.dockAndPlayEpisode({
            slug,
            title,
            seriesPart: parseInt(partNum, 10),
            episodeNumber: parseInt(epNumber, 10),
            format: formatLabel,
            audio: {
              src: audioSrc,
              durationSeconds: parseInt(duration, 10) * 60,
            },
          });
          syncPlaybackState(currentPlayingSlug, true);

          // Scroll docked player into viewport if offscreen (respecting prefers-reduced-motion)
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          dockedSection?.scrollIntoView({
            behavior: prefersReduced ? 'auto' : 'smooth',
            block: 'nearest',
          });

          // Dispatch decoupled event
          window.dispatchEvent(
            new CustomEvent('lukethinks:dock-audio', {
              detail: {
                slug,
                title,
                episodeNumber: epNumber,
                partNumber: partNum,
                format: formatLabel,
                audioSrc,
                durationMinutes: duration,
              },
              bubbles: true,
            })
          );
        });
      });

      // Drawer episode keyboard interactions (scoped to active series tracklist)
      drawerEpisodeItems.forEach((item) => {
        item.addEventListener('keydown', (e: KeyboardEvent) => {
          const target = e.target as HTMLElement;

          // If the key event originated from an interactive child (a or button), let the element handle Enter and Space natively
          if ((e.key === 'Enter' || e.key === ' ') && target !== item && (target.closest('a') || target.closest('button'))) {
            return;
          }

          const activeSeriesContent = item.closest<HTMLElement>('.drawer-series-content');
          const siblingItems = activeSeriesContent
            ? Array.from(activeSeriesContent.querySelectorAll<HTMLElement>('.drawer-episode-item'))
            : Array.from(drawerEpisodeItems);
          const currentLocalIdx = siblingItems.indexOf(item);
          const isButtonFocused = Boolean(target.closest('.drawer-play-btn'));

          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const playBtn = item.querySelector<HTMLButtonElement>('.drawer-play-btn');
            playBtn?.click();
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (currentLocalIdx >= 0 && currentLocalIdx < siblingItems.length - 1) {
              const nextItem = siblingItems[currentLocalIdx + 1];
              if (isButtonFocused || target.classList.contains('drawer-play-btn')) {
                nextItem?.querySelector<HTMLElement>('.drawer-play-btn')?.focus();
              } else {
                nextItem?.focus();
              }
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (currentLocalIdx > 0) {
              const prevItem = siblingItems[currentLocalIdx - 1];
              if (isButtonFocused || target.classList.contains('drawer-play-btn')) {
                prevItem?.querySelector<HTMLElement>('.drawer-play-btn')?.focus();
              } else {
                prevItem?.focus();
              }
            } else {
              const activeSlide = slides[stateMachine.activeIndex];
              const triggerBtn = activeSlide?.querySelector<HTMLButtonElement>('.carousel-series-toggle-btn');
              (triggerBtn || activeSlide)?.focus();
            }
          } else if (e.key === 'Home') {
            e.preventDefault();
            if (siblingItems.length > 0) {
              if (isButtonFocused || target.classList.contains('drawer-play-btn')) {
                siblingItems[0]?.querySelector<HTMLElement>('.drawer-play-btn')?.focus();
              } else {
                siblingItems[0]?.focus();
              }
            }
          } else if (e.key === 'End') {
            e.preventDefault();
            if (siblingItems.length > 0) {
              const lastItem = siblingItems[siblingItems.length - 1];
              if (isButtonFocused || target.classList.contains('drawer-play-btn')) {
                lastItem?.querySelector<HTMLElement>('.drawer-play-btn')?.focus();
              } else {
                lastItem?.focus();
              }
            }
          }
        });
      });

      // Escape key handler on container/drawer
      container.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          if (seriesDrawer && seriesDrawer.classList.contains('is-expanded')) {
            e.preventDefault();
            collapseDrawer(true);
          }
        }
      });

      // Slide click interaction
      slides.forEach((slide, idx) => {
        slide.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('a') || target.closest('button')) return;

          if (stateMachine.viewMode !== 'grid') {
            if (idx !== stateMachine.activeIndex) {
              goToSlide(idx, true);
              if (slide.dataset.isSeries === 'true') {
                expandDrawer(idx, false);
              }
            } else {
              if (slide.dataset.isSeries === 'true') {
                toggleDrawer(idx, false);
              } else {
                dockAndPlay(slide, true);
              }
            }
          }
        });
      });

      // Keyboard navigation strictly on horizontal axis (ArrowUp and ArrowDown NOT intercepted for page scroll)
      track.addEventListener('keydown', (e: KeyboardEvent) => {
        if (stateMachine.viewMode === 'grid') return;

        switch (e.key) {
          case 'ArrowLeft':
            e.preventDefault();
            goToSlide(stateMachine.prev(), true);
            break;
          case 'ArrowRight':
            e.preventDefault();
            goToSlide(stateMachine.next(), true);
            break;
          case 'ArrowDown': {
            if (seriesDrawer && seriesDrawer.classList.contains('is-expanded')) {
              e.preventDefault();
              const firstDrawerBtn = seriesDrawer.querySelector<HTMLElement>(
                '.drawer-series-content.is-active .drawer-play-btn, .drawer-series-content.is-active .drawer-episode-item'
              );
              firstDrawerBtn?.focus();
            }
            break;
          }
          case 'Home':
            e.preventDefault();
            goToSlide(stateMachine.home(), true);
            break;
          case 'End':
            e.preventDefault();
            goToSlide(stateMachine.end(), true);
            break;
          case 'PageUp':
            e.preventDefault();
            goToSlide(stateMachine.selectItem(stateMachine.activeIndex - 3), true);
            break;
          case 'PageDown':
            e.preventDefault();
            goToSlide(stateMachine.selectItem(stateMachine.activeIndex + 3), true);
            break;
          case 'Enter':
          case ' ': {
            const target = e.target as HTMLElement;
            if (!target.closest('a') && !target.closest('button')) {
              e.preventDefault();
              const activeSlide = slides[stateMachine.activeIndex];
              if (activeSlide) {
                if (activeSlide.dataset.isSeries === 'true') {
                  toggleDrawer(stateMachine.activeIndex, false);
                } else {
                  dockAndPlay(activeSlide, true);
                }
              }
            }
            break;
          }
          default:
            break;
        }
      });

      // Scroll synchronization
      function handleScrollSync() {
        if (isProgrammaticScroll || stateMachine.viewMode === 'grid') return;
        const newIndex = findCenterIndex();
        if (newIndex !== stateMachine.activeIndex) {
          const wasDrawerOpen = stateMachine.expandedSeriesIndex !== null;
          const clampedIndex = stateMachine.selectItem(newIndex);
          updateSlideClasses(clampedIndex);

          if (wasDrawerOpen) {
            if (stateMachine.expandedSeriesIndex !== null) {
              expandDrawer(clampedIndex, false);
            } else {
              collapseDrawer(false);
            }
          }
        }
      }

      track.addEventListener('scroll', () => {
        if (scrollDebounceTimer) clearTimeout(scrollDebounceTimer);
        scrollDebounceTimer = setTimeout(handleScrollSync, 60);
      }, { passive: true });

      track.addEventListener('scrollend', handleScrollSync, { passive: true });

      // Synchronize audio playback events
      const docked = getDockedPlayerElements();
      if (docked?.audio) {
        docked.audio.addEventListener('play', () => {
          enforceExclusivePlayback(
            docked.audio,
            document.querySelectorAll<HTMLAudioElement>('audio.custom-audio-player')
          );
          if (!currentPlayingSlug) {
            const activeSlide = slides[stateMachine.activeIndex];
            if (activeSlide?.dataset.isSeries === 'true') {
              const firstDrawerPlay = seriesDrawer?.querySelector<HTMLButtonElement>(
                `.drawer-series-content[data-series-index="${stateMachine.activeIndex}"] .drawer-play-btn`
              );
              currentPlayingSlug = firstDrawerPlay?.dataset.slug || activeSlide.dataset.slug || null;
            } else {
              currentPlayingSlug = activeSlide?.dataset.slug || null;
            }
          }
          syncPlaybackState(currentPlayingSlug, true);
        });

        docked.audio.addEventListener('pause', () => {
          syncPlaybackState(currentPlayingSlug, false);
        });

        docked.audio.addEventListener('ended', () => {
          syncPlaybackState(currentPlayingSlug, false);
        });
      }

      // External audio playback mutual exclusion
      document.addEventListener('play', (e) => {
        const target = e.target as HTMLAudioElement;
        if (target && target !== docked?.audio && !docked?.audio?.paused) {
          docked?.audio?.pause();
        }
      }, true);

      // Initial alignment
      updateSlideClasses(stateMachine.activeIndex);
      if (stateMachine.viewMode !== 'grid') {
        scrollToIndex(stateMachine.activeIndex, false);
      }

      window.addEventListener('resize', () => {
        if (stateMachine.viewMode !== 'grid') {
          scrollToIndex(stateMachine.activeIndex, false);
        }
      }, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAudioCarousels);
  } else {
    initAudioCarousels();
  }
  document.addEventListener('astro:page-load', initAudioCarousels);
</script>

