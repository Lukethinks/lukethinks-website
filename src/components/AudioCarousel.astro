---
import AudioPlayer from './AudioPlayer.astro';
import { resolveAudioUrl } from '../utils/audio';

export interface CarouselItem {
  id: string;
  slug: string;
  title: string;
  summary: string;
  published: Date | string;
  episodeNumber?: number;
  season?: number;
  format?: 'briefing' | 'debate' | 'narration' | 'summary' | string;
  tags?: string[];
  confidence?: 'low' | 'medium' | 'high' | string;
  audio: {
    src: string;
    bytes: number;
    durationSeconds: number;
    mimeType?: string;
  };
  takeaways?: string[];
  companionArticle?: {
    title: string;
    href: string;
  };
  production?: {
    source?: string;
    aiDisclosed?: boolean;
  };
}

export interface Props {
  id?: string;
  items: CarouselItem[];
  title?: string;
  subtitle?: string;
  initialIndex?: number;
  defaultView?: 'carousel' | 'grid';
  showDockedPlayer?: boolean;
  dockedHeadingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  id = 'audio-carousel',
  items = [],
  title = 'Featured Audio & Episodes',
  subtitle = 'Browse executive briefings and debates.',
  initialIndex = 0,
  defaultView = 'carousel',
  showDockedPlayer = true,
  dockedHeadingLevel = 'h3',
  class: className = '',
} = Astro.props;

const totalItems = items.length;
const safeInitialIndex = totalItems > 0 ? Math.max(0, Math.min(totalItems - 1, initialIndex)) : 0;
const initialItem = items[safeInitialIndex];
const initialResolvedAudio = initialItem ? resolveAudioUrl(initialItem.audio.src) : '';

const containerId = id;
const announcerId = `${id}-announcer`;
const trackId = `${id}-track`;
const dockedPlayerId = `${id}-docked-player`;
const dockedHeadingId = `${id}-docked-heading`;
const dockedStationId = `${id}-docked-station`;
---

<section
  class={`audio-carousel-container ${defaultView === 'grid' ? 'is-grid-view' : 'is-carousel-view'} ${className}`.trim()}
  id={containerId}
  data-component="audio-carousel"
  data-initial-index={safeInitialIndex}
  data-total-items={totalItems}
  role="region"
  aria-roledescription="carousel"
  aria-label={title}
>
  <!-- Screen reader live announcer -->
  <div class="sr-only" aria-live="polite" aria-atomic="true" id={announcerId}>
    {initialItem ? `Slide 1 of ${totalItems}: ${initialItem.title}` : 'No episodes available'}
  </div>

  <!-- Carousel Header & Mode Toolbar -->
  <div class="carousel-header">
    <div class="carousel-title-group">
      <h2 class="carousel-section-title">{title}</h2>
      {subtitle && <p class="carousel-section-subtitle">{subtitle}</p>}
    </div>

    {totalItems > 0 && (
      <div class="carousel-toolbar" role="toolbar" aria-label="Carousel navigation and view controls">
        <div class="carousel-track-counter" aria-hidden="true">
          <span class="track-indicator">
            <span class="current-track-num">{safeInitialIndex + 1}</span> of <span class="total-tracks-num">{totalItems}</span>
          </span>
        </div>

        <div class="view-mode-toggle" role="group" aria-label="Catalog view mode">
          <button
            type="button"
            class={`view-btn ${defaultView === 'carousel' ? 'is-active' : ''}`}
            data-view="carousel"
            aria-pressed={defaultView === 'carousel' ? 'true' : 'false'}
            aria-label="Switch to carousel view"
          >
            <span class="view-btn-icon" aria-hidden="true">🎛️</span>
            <span class="view-btn-label">Carousel</span>
          </button>
          <button
            type="button"
            class={`view-btn ${defaultView === 'grid' ? 'is-active' : ''}`}
            data-view="grid"
            aria-pressed={defaultView === 'grid' ? 'true' : 'false'}
            aria-label="Switch to responsive grid view"
          >
            <span class="view-btn-icon" aria-hidden="true">▦</span>
            <span class="view-btn-label">Grid View</span>
          </button>
        </div>
      </div>
    )}
  </div>

  {totalItems === 0 ? (
    <div class="empty-state">
      <p>No audio episodes available in catalog.</p>
    </div>
  ) : (
    <>
      <!-- Carousel Stage Viewport -->
      <div class="audio-carousel-stage">
        <!-- Edge Stepper Buttons -->
        <button
          type="button"
          class="carousel-stepper-btn prev-btn"
          aria-label="Previous episode"
          aria-controls={trackId}
          disabled={safeInitialIndex === 0}
        >
          <span class="stepper-icon" aria-hidden="true">‹</span>
        </button>

        <button
          type="button"
          class="carousel-stepper-btn next-btn"
          aria-label="Next episode"
          aria-controls={trackId}
          disabled={safeInitialIndex >= totalItems - 1}
        >
          <span class="stepper-icon" aria-hidden="true">›</span>
        </button>

        <!-- Horizontal Scroller Track -->
        <div
          class="carousel-track"
          id={trackId}
          role="group"
          aria-label="Episode slides"
          tabindex="0"
        >
          {items.map((item, idx) => {
            const isInitial = idx === safeInitialIndex;
            const isFocusable = isInitial || defaultView === 'grid';
            const childTabIndex = isFocusable ? '0' : '-1';
            const isInert = !isInitial && defaultView !== 'grid';
            const epNum = item.episodeNumber ?? (idx + 1);
            const epNumPadded = String(epNum).padStart(2, '0');
            const durationMin = Math.ceil(item.audio.durationSeconds / 60);
            const pubDate = new Date(item.published);
            const pubDateHuman = pubDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            });
            const isDebate = (item.format === 'debate') || item.title.toLowerCase().includes('debate');
            const formatLabel = isDebate ? 'Point · Counterpoint' : 'Executive Briefing';
            const resolvedSrc = resolveAudioUrl(item.audio.src);

            let initialFlankClass = '';
            if (isInitial) {
              initialFlankClass = 'is-active';
            } else if (idx === safeInitialIndex - 1) {
              initialFlankClass = 'is-prev';
            } else if (idx < safeInitialIndex - 1) {
              initialFlankClass = 'is-far-prev';
            } else if (idx === safeInitialIndex + 1) {
              initialFlankClass = 'is-next';
            } else {
              initialFlankClass = 'is-far-next';
            }

            return (
              <article
                class={`carousel-item ${initialFlankClass}`.trim()}
                role="group"
                aria-roledescription="slide"
                aria-label={`Episode ${idx + 1} of ${totalItems}: ${item.title}`}
                data-index={idx}
                data-slug={item.slug}
                data-title={item.title}
                data-episode={epNumPadded}
                data-format={item.format || (isDebate ? 'debate' : 'briefing')}
                data-format-label={formatLabel}
                data-audio-src={resolvedSrc}
                data-duration={durationMin}
                data-duration-seconds={item.audio.durationSeconds}
                data-companion-href={item.companionArticle?.href || ''}
                data-companion-title={item.companionArticle?.title || ''}
                tabindex={isFocusable ? '0' : '-1'}
                aria-current={isInitial ? 'true' : undefined}
                inert={isInert ? true : undefined}
              >
                <div class="carousel-card-inner">
                  <!-- 1:1 Square Artwork Badge with Floor Reflection -->
                  <div class="carousel-card-artwork" aria-hidden="true">
                    <div class="artwork-inner">
                      <span class="artwork-icon">{isDebate ? '⚖️' : '🎙️'}</span>
                      <span class="artwork-number">EP {epNumPadded}</span>
                      <span class="artwork-label">{formatLabel}</span>
                    </div>
                  </div>

                  <!-- Card Editorial Content -->
                  <div class="carousel-card-content">
                    <div class="carousel-card-meta">
                      <span class="carousel-badge">EP {epNumPadded}</span>
                      <span class="carousel-format-badge">{isDebate ? 'Debate' : 'Briefing'}</span>
                      <time datetime={pubDate.toISOString().slice(0, 10)} class="carousel-date">{pubDateHuman}</time>
                      <span class="carousel-duration">⏱️ {durationMin} min</span>
                      {item.confidence && (
                        <span class="carousel-confidence">
                          {item.confidence}
                        </span>
                      )}
                    </div>

                    <h3 class="carousel-card-title">
                      <a
                        href={`/podcast/${item.slug}`}
                        class="carousel-title-link"
                        tabindex={childTabIndex}
                      >
                        {item.title}
                      </a>
                    </h3>

                    <p class="carousel-card-summary">{item.summary}</p>

                    {item.takeaways && item.takeaways.length > 0 && (
                      <div class="carousel-takeaways-preview">
                        <h4 class="takeaways-preview-heading">Key Takeaway:</h4>
                        <ul class="takeaways-preview-list">
                          <li>{item.takeaways[0]}</li>
                        </ul>
                      </div>
                    )}

                    <!-- Card Actions -->
                    <div class="carousel-card-actions">
                      <button
                        type="button"
                        class="carousel-play-btn"
                        data-index={idx}
                        data-slug={item.slug}
                        aria-label={`Play Episode ${epNumPadded}: ${item.title}`}
                        tabindex={childTabIndex}
                      >
                        <span class="play-btn-icon" aria-hidden="true">▶</span>
                        <span class="play-btn-text">Listen</span>
                      </button>

                      <a
                        href={`/podcast/${item.slug}`}
                        class="carousel-detail-link"
                        tabindex={childTabIndex}
                      >
                        Show Notes →
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Docked Master Audio Player Section -->
      {showDockedPlayer && initialItem && (
        <section
          class="audio-docked-section has-docked-audio"
          id={dockedPlayerId}
          aria-labelledby={dockedHeadingId}
        >
          <div class="docked-section-header">
            <h3 id={dockedHeadingId} class="docked-title">
              <span class="docked-icon" aria-hidden="true">🎧</span>
              <span class="docked-title-text">Now Playing Station</span>
            </h3>
          </div>

          <div class="docked-player-wrapper">
            <AudioPlayer
              src={initialResolvedAudio}
              title={`Play Episode ${String(initialItem.episodeNumber ?? 1).padStart(2, '0')}: ${initialItem.title}`}
              id={dockedStationId}
              durationSeconds={initialItem.audio.durationSeconds}
              variant={initialItem.format || 'episode'}
              headingLevel={dockedHeadingLevel}
              aiDisclosed={initialItem.production?.aiDisclosed}
              disclosureText="AI voices curated, directed and fact-checked by Luke."
            />
          </div>
        </section>
      )}
    </>
  )}
</section>

<!-- Noscript graceful degradation -->
<noscript>
  <style>
    .carousel-toolbar,
    .carousel-stepper-btn {
      display: none !important;
    }
    .audio-carousel-stage {
      perspective: none !important;
    }
    .carousel-track {
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
      gap: 2rem !important;
      overflow-x: visible !important;
      scroll-snap-type: none !important;
      padding: 1rem 0 !important;
    }
    .carousel-item {
      flex: initial !important;
      width: 100% !important;
      transform: none !important;
      opacity: 1 !important;
      outline: none !important;
      z-index: auto !important;
    }
    .carousel-card-artwork {
      -webkit-box-reflect: none !important;
    }
  </style>
</noscript>

<script>
  import { CarouselStateMachine, enforceExclusivePlayback } from '../utils/carousel-state';

  function initAudioCarousels() {
    const containers = document.querySelectorAll<HTMLElement>('.audio-carousel-container[data-component="audio-carousel"]');

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const containerId = container.id || 'audio-carousel';
      const track = container.querySelector<HTMLElement>('.carousel-track');
      const slides = Array.from(container.querySelectorAll<HTMLElement>('.carousel-item'));
      const prevBtn = container.querySelector<HTMLButtonElement>('.carousel-stepper-btn.prev-btn');
      const nextBtn = container.querySelector<HTMLButtonElement>('.carousel-stepper-btn.next-btn');
      const currentTrackNum = container.querySelector<HTMLElement>('.current-track-num');
      const announcer = container.querySelector<HTMLElement>(`#${containerId}-announcer`) ||
        container.querySelector<HTMLElement>('.sr-only[aria-live="polite"]');
      const viewButtons = container.querySelectorAll<HTMLButtonElement>('.view-btn');
      const dockedSection = container.querySelector<HTMLElement>(`#${containerId}-docked-player`) ||
        container.querySelector<HTMLElement>('.audio-docked-section');
      const playButtons = container.querySelectorAll<HTMLButtonElement>('.carousel-play-btn');

      if (!track || slides.length === 0) return;

      const itemsData = slides.map((slide, idx) => ({
        slug: slide.dataset.slug || '',
        title: slide.dataset.title || '',
        episodeNumber: parseInt(slide.dataset.episode || String(idx + 1), 10),
        format: slide.dataset.format || '',
        audio: {
          src: slide.dataset.audioSrc || '',
          durationSeconds: parseInt(slide.dataset.durationSeconds || '0', 10),
        },
      }));

      const stateMachine = new CarouselStateMachine(itemsData, {
        initialIndex: parseInt(container.dataset.initialIndex || '0', 10),
        defaultView: container.classList.contains('is-grid-view') ? 'grid' : 'carousel',
        prefersReducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      });

      let currentPlayingSlug: string | null = null;
      let isProgrammaticScroll = false;
      let scrollDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      // Locate docked player DOM elements
      function getDockedPlayerElements() {
        if (!dockedSection) return null;
        const audio = dockedSection.querySelector<HTMLAudioElement>('audio.custom-audio-player');
        const titleEl = dockedSection.querySelector<HTMLElement>('.audio-title');
        const variantEl = dockedSection.querySelector<HTMLElement>('.audio-variant-label');
        const timeEl = dockedSection.querySelector<HTMLElement>('.audio-meta time');
        const downloadLink = dockedSection.querySelector<HTMLAnchorElement>('.audio-download-action');
        return { audio, titleEl, variantEl, timeEl, downloadLink };
      }

      function updatePlayButtonUI(slide: HTMLElement, isPlaying: boolean) {
        const btn = slide.querySelector<HTMLButtonElement>('.carousel-play-btn');
        if (!btn) return;
        const icon = btn.querySelector<HTMLElement>('.play-btn-icon');
        const text = btn.querySelector<HTMLElement>('.play-btn-text');
        const ep = slide.dataset.episode || '';
        const t = slide.dataset.title || '';

        if (isPlaying) {
          btn.classList.add('is-playing');
          btn.setAttribute('aria-label', `Pause Episode ${ep}: ${t}`);
          if (icon) icon.textContent = '⏸';
          if (text) text.textContent = 'Pause';
        } else {
          btn.classList.remove('is-playing');
          btn.setAttribute('aria-label', `Play Episode ${ep}: ${t}`);
          if (icon) icon.textContent = '▶';
          if (text) text.textContent = 'Listen';
        }
      }

      function updateSlideClasses(activeIndex: number) {
        const isGridView = stateMachine.viewMode === 'grid';

        slides.forEach((slide, idx) => {
          slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-far-prev', 'is-far-next');

          if (isGridView) {
            slide.setAttribute('tabindex', '0');
            slide.removeAttribute('inert');
            slide.removeAttribute('aria-current');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '0'));
            return;
          }

          if (idx === activeIndex) {
            slide.classList.add('is-active');
            slide.setAttribute('tabindex', '0');
            slide.setAttribute('aria-current', 'true');
            slide.removeAttribute('inert');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '0'));
          } else {
            slide.setAttribute('tabindex', '-1');
            slide.removeAttribute('aria-current');
            slide.setAttribute('inert', '');
            const links = slide.querySelectorAll<HTMLElement>('a, button');
            links.forEach((l) => l.setAttribute('tabindex', '-1'));

            if (idx === activeIndex - 1) {
              slide.classList.add('is-prev');
            } else if (idx < activeIndex - 1) {
              slide.classList.add('is-far-prev');
            } else if (idx === activeIndex + 1) {
              slide.classList.add('is-next');
            } else {
              slide.classList.add('is-far-next');
            }
          }
        });

        // Update counter & steppers
        if (currentTrackNum) {
          currentTrackNum.textContent = String(activeIndex + 1);
        }

        if (prevBtn) prevBtn.disabled = activeIndex === 0;
        if (nextBtn) nextBtn.disabled = activeIndex >= slides.length - 1;

        // Screen reader announcement
        if (announcer && slides[activeIndex]) {
          const itemTitle = slides[activeIndex].dataset.title || '';
          announcer.textContent = `Slide ${activeIndex + 1} of ${slides.length}: ${itemTitle}`;
        }
      }

      function scrollToIndex(index: number, smooth = true) {
        if (!track || !slides[index]) return;
        isProgrammaticScroll = true;

        const slide = slides[index];
        const trackWidth = track.clientWidth;
        const slideWidth = slide.offsetWidth;
        const slideLeft = slide.offsetLeft;

        // Target center offset
        const targetScrollLeft = slideLeft - (trackWidth / 2) + (slideWidth / 2);

        track.scrollTo({
          left: Math.max(0, targetScrollLeft),
          behavior: smooth ? 'smooth' : 'auto',
        });

        setTimeout(() => {
          isProgrammaticScroll = false;
        }, smooth ? 450 : 50);
      }

      function goToSlide(index: number, focusCard = false) {
        const clampedIndex = stateMachine.selectItem(index);
        updateSlideClasses(clampedIndex);

        if (stateMachine.viewMode !== 'grid') {
          scrollToIndex(clampedIndex, true);
        }

        if (focusCard && slides[clampedIndex] && stateMachine.viewMode !== 'grid') {
          slides[clampedIndex].focus();
        }
      }

      function findCenterIndex(): number {
        if (!track) return stateMachine.activeIndex;
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        let closestIndex = 0;
        let minDistance = Infinity;

        slides.forEach((slide, idx) => {
          const rect = slide.getBoundingClientRect();
          const slideCenter = rect.left + rect.width / 2;
          const dist = Math.abs(slideCenter - trackCenter);
          if (dist < minDistance) {
            minDistance = dist;
            closestIndex = idx;
          }
        });

        return closestIndex;
      }

      function dockAndPlay(slide: HTMLElement, toggleIfSame = true) {
        const slug = slide.dataset.slug || '';
        const title = slide.dataset.title || '';
        const ep = slide.dataset.episode || '';
        const formatLabel = slide.dataset.formatLabel || '';
        const audioSrc = slide.dataset.audioSrc || '';
        const duration = slide.dataset.duration || '';

        const docked = getDockedPlayerElements();
        if (!docked || !docked.audio) return;

        if (toggleIfSame && currentPlayingSlug === slug) {
          if (docked.audio.paused) {
            docked.audio.play().catch(() => {});
          } else {
            docked.audio.pause();
          }
          return;
        }

        // Update player contents
        if (docked.titleEl) {
          docked.titleEl.textContent = `Play Episode ${ep}: ${title}`;
        }
        if (docked.variantEl && formatLabel) {
          docked.variantEl.textContent = formatLabel;
        }
        if (docked.timeEl && duration) {
          docked.timeEl.textContent = `${duration} min`;
        }
        if (docked.downloadLink && audioSrc) {
          docked.downloadLink.href = audioSrc;
          docked.downloadLink.setAttribute('aria-label', `Download MP3 for Episode ${ep}: ${title}`);
        }

        docked.audio.src = audioSrc;
        const sourceEl = docked.audio.querySelector<HTMLSourceElement>('source');
        if (sourceEl) {
          sourceEl.src = audioSrc;
        }
        docked.audio.setAttribute('aria-label', `Play Episode ${ep}: ${title}`);
        docked.audio.load();

        docked.audio.play().catch((err) => {
          console.log('Audio play triggered:', err);
        });

        currentPlayingSlug = slug;
        stateMachine.dockAndPlayActive();

        // Update slide states
        slides.forEach((s) => {
          s.classList.remove('is-docked', 'is-playing');
          updatePlayButtonUI(s, false);
        });

        slide.classList.add('is-docked', 'is-playing');
        updatePlayButtonUI(slide, true);

        // Dispatch decoupled event for observers
        window.dispatchEvent(
          new CustomEvent('lukethinks:dock-audio', {
            detail: {
              slug,
              title,
              episodeNumber: ep,
              format: formatLabel,
              audioSrc,
              durationMinutes: duration,
            },
            bubbles: true,
          })
        );
      }

      function switchView(mode: string | undefined) {
        const newMode = stateMachine.toggleView(mode as 'carousel' | 'grid');
        const isGridView = newMode === 'grid';
        if (isGridView) {
          container.classList.remove('is-carousel-view');
          container.classList.add('is-grid-view');
        } else {
          container.classList.remove('is-grid-view');
          container.classList.add('is-carousel-view');
        }

        viewButtons.forEach((btn) => {
          const isActive = btn.dataset.view === newMode;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });

        updateSlideClasses(stateMachine.activeIndex);
        if (!isGridView) {
          scrollToIndex(stateMachine.activeIndex, false);
        }
      }

      // Stepper button events
      prevBtn?.addEventListener('click', () => goToSlide(stateMachine.prev(), true));
      nextBtn?.addEventListener('click', () => goToSlide(stateMachine.next(), true));

      // View toggle buttons
      viewButtons.forEach((btn) => {
        btn.addEventListener('click', () => switchView(btn.dataset.view));
      });

      // Play button actions
      playButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slide = btn.closest<HTMLElement>('.carousel-item');
          if (slide) dockAndPlay(slide, true);
        });
      });

      // Slide click interaction
      slides.forEach((slide, idx) => {
        slide.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('a') || target.closest('button')) return;

          if (stateMachine.viewMode !== 'grid') {
            if (idx !== stateMachine.activeIndex) {
              goToSlide(idx, true);
            } else {
              dockAndPlay(slide, true);
            }
          }
        });
      });

      // Keyboard navigation strictly on horizontal axis (ArrowUp and ArrowDown NOT intercepted)
      track.addEventListener('keydown', (e: KeyboardEvent) => {
        if (stateMachine.viewMode === 'grid') return;

        switch (e.key) {
          case 'ArrowLeft':
            e.preventDefault();
            goToSlide(stateMachine.prev(), true);
            break;
          case 'ArrowRight':
            e.preventDefault();
            goToSlide(stateMachine.next(), true);
            break;
          case 'Home':
            e.preventDefault();
            goToSlide(stateMachine.home(), true);
            break;
          case 'End':
            e.preventDefault();
            goToSlide(stateMachine.end(), true);
            break;
          case 'PageUp':
            e.preventDefault();
            goToSlide(stateMachine.selectItem(stateMachine.activeIndex - 3), true);
            break;
          case 'PageDown':
            e.preventDefault();
            goToSlide(stateMachine.selectItem(stateMachine.activeIndex + 3), true);
            break;
          case 'Enter':
          case ' ': {
            const target = e.target as HTMLElement;
            if (!target.closest('a')) {
              e.preventDefault();
              if (slides[stateMachine.activeIndex]) {
                dockAndPlay(slides[stateMachine.activeIndex], true);
              }
            }
            break;
          }
          default:
            break;
        }
      });

      // Scroll synchronization
      function handleScrollSync() {
        if (isProgrammaticScroll || stateMachine.viewMode === 'grid') return;
        const newIndex = findCenterIndex();
        if (newIndex !== stateMachine.activeIndex) {
          updateSlideClasses(newIndex);
        }
      }

      track.addEventListener('scroll', () => {
        if (scrollDebounceTimer) clearTimeout(scrollDebounceTimer);
        scrollDebounceTimer = setTimeout(handleScrollSync, 60);
      }, { passive: true });

      track.addEventListener('scrollend', handleScrollSync, { passive: true });

      // Synchronize audio playback events
      const docked = getDockedPlayerElements();
      if (docked?.audio) {
        docked.audio.addEventListener('play', () => {
          enforceExclusivePlayback(
            docked.audio,
            document.querySelectorAll<HTMLAudioElement>('audio.custom-audio-player')
          );

          if (currentPlayingSlug) {
            const currentSlide = slides.find((s) => s.dataset.slug === currentPlayingSlug);
            if (currentSlide) {
              currentSlide.classList.add('is-playing');
              updatePlayButtonUI(currentSlide, true);
            }
          }
        });

        docked.audio.addEventListener('pause', () => {
          if (currentPlayingSlug) {
            const currentSlide = slides.find((s) => s.dataset.slug === currentPlayingSlug);
            if (currentSlide) {
              currentSlide.classList.remove('is-playing');
              updatePlayButtonUI(currentSlide, false);
            }
          }
        });

        docked.audio.addEventListener('ended', () => {
          if (currentPlayingSlug) {
            const currentSlide = slides.find((s) => s.dataset.slug === currentPlayingSlug);
            if (currentSlide) {
              currentSlide.classList.remove('is-playing');
              updatePlayButtonUI(currentSlide, false);
            }
          }
        });
      }

      // External audio playback mutual exclusion
      document.addEventListener('play', (e) => {
        const target = e.target as HTMLAudioElement;
        if (target && target !== docked?.audio && !docked?.audio?.paused) {
          docked?.audio?.pause();
        }
      }, true);

      // Initial alignment
      updateSlideClasses(stateMachine.activeIndex);
      if (stateMachine.viewMode !== 'grid') {
        scrollToIndex(stateMachine.activeIndex, false);
      }

      window.addEventListener('resize', () => {
        if (stateMachine.viewMode !== 'grid') {
          scrollToIndex(stateMachine.activeIndex, false);
        }
      }, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAudioCarousels);
  } else {
    initAudioCarousels();
  }
  document.addEventListener('astro:page-load', initAudioCarousels);
</script>

