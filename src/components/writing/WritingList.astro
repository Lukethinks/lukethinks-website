---
// The Writing index: every published piece, newest first, with search and a category filter.
// Cards say when audio exists for the piece, so "is there a podcast version?" is visible here.
import type { WritingItem } from '../../utils/writing';

interface Props {
  items: WritingItem[];
}

const { items } = Astro.props;
const categories = [...new Set(items.map((i) => i.category))];
---

<div class="writing" data-writing>
  <div class="writing-controls">
    <label class="writing-search">
      <span class="sr-only">Search writing</span>
      <input type="search" data-writing-search placeholder="Search by title, topic or tag" />
    </label>

    {categories.length > 1 && (
      <div class="writing-filters" role="group" aria-label="Filter by category">
        <button type="button" class="writing-filter is-active" data-writing-filter="" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button type="button" class="writing-filter" data-writing-filter={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    )}
  </div>

  <ul class="writing-list">
    {items.map((i) => (
      <li
        class="writing-item"
        data-writing-item
        data-category={i.category}
        data-text={`${i.title} ${i.summary} ${i.tags.join(' ')}`.toLowerCase()}
      >
        <p class="writing-item-meta">
          <span class="writing-item-category">{i.category}</span>
          <time datetime={i.publishedIso}>{i.publishedHuman}</time>
          {i.confidence && <span class="confidence-badge" data-confidence={i.confidence}>Confidence: {i.confidence}</span>}
        </p>
        <h2 class="writing-item-title"><a href={i.href}>{i.title}</a></h2>
        <p class="writing-item-summary">{i.summary}</p>
        {i.episodeCount > 0 && (
          <p class="writing-item-audio">
            <span aria-hidden="true">🎧</span>
            Also as audio · <a href={`${i.href}#listen`}>{i.episodeCount} podcast episode{i.episodeCount === 1 ? '' : 's'}</a>
          </p>
        )}
      </li>
    ))}
  </ul>

  <p class="writing-empty" data-writing-empty hidden>Nothing matches. Try a different search or filter.</p>
</div>

<script>
  function initWriting() {
    document.querySelectorAll<HTMLElement>('[data-writing]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';

      const search = root.querySelector<HTMLInputElement>('[data-writing-search]');
      const buttons = root.querySelectorAll<HTMLButtonElement>('[data-writing-filter]');
      const rows = root.querySelectorAll<HTMLElement>('[data-writing-item]');
      const empty = root.querySelector<HTMLElement>('[data-writing-empty]');
      let category = '';

      const apply = () => {
        const q = (search?.value ?? '').toLowerCase().trim();
        let shown = 0;
        rows.forEach((row) => {
          const ok = (!category || row.dataset.category === category) && (!q || (row.dataset.text ?? '').includes(q));
          row.hidden = !ok;
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      };

      search?.addEventListener('input', apply);
      buttons.forEach((btn) =>
        btn.addEventListener('click', () => {
          category = btn.dataset.writingFilter ?? '';
          buttons.forEach((b) => {
            b.classList.toggle('is-active', b === btn);
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          apply();
        }),
      );
    });
  }

  initWriting();
  document.addEventListener('astro:page-load', initWriting);
</script>

<style>
  .writing {
    max-width: 860px;
    margin: 0 auto 3.5rem;
  }

  .writing-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .writing-search input {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-light);
    background: var(--surface-input);
    color: var(--dark-text);
    font: inherit;
    box-shadow: 0 2px 8px var(--shadow-light);
  }

  .writing-search input:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 2px;
  }

  .writing-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .writing-filter {
    padding: 0.45rem 1rem;
    border-radius: 50px;
    border: 1px solid var(--border-light);
    background: var(--surface-button);
    color: var(--light-text);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .writing-filter:hover {
    color: var(--dark-text);
    border-color: var(--accent-amber);
  }

  .writing-filter:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 2px;
  }

  .writing-filter.is-active {
    background: var(--dark-text);
    border-color: var(--dark-text);
    color: var(--light-cream);
  }

  .writing-list {
    list-style: none;
    margin: 0;
    padding: 0 1.75rem;
    border-radius: 16px;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    box-shadow: 0 4px 16px var(--shadow-light);
  }

  .writing-item {
    margin: 0;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border-light);
  }

  .writing-item:first-child {
    border-top: 0;
  }

  .writing-item[hidden] {
    display: none;
  }

  .writing-item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0 0 0.4rem;
    font-size: 0.82rem;
    color: var(--light-text);
  }

  .writing-item-category {
    font-weight: 700;
    color: var(--primary-brown);
  }

  .writing-item-title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .writing-item-title a {
    color: var(--dark-text);
    text-decoration: none;
  }

  .writing-item-title a:hover {
    color: var(--accent-amber);
  }

  .writing-item-summary {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--light-text);
  }

  .writing-item-audio {
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--medium-text);
  }

  .writing-item-audio a {
    font-weight: 700;
    color: var(--accent-amber);
  }

  .writing-empty {
    margin: 1.5rem 0 0;
    text-align: center;
    color: var(--light-text);
  }

  @media (max-width: 768px) {
    .writing-list {
      padding: 0 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-filter {
      transition: none;
    }
  }
</style>
