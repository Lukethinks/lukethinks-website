---
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReactionsBar from '../../components/ReactionsBar.astro';
import CompanionAudioBanner from '../../components/CompanionAudioBanner.astro';
import { resolveAudioUrl } from '../../utils/audio';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Dynamically fetch companion audio from the generated registry
let companionAudio = [];
try {
  const registryPath = join(process.cwd(), 'content', 'data', 'audio-registry.json');
  const registry = JSON.parse(readFileSync(registryPath, 'utf8'));
  companionAudio = registry.filter(a => a.slug === article.data.slug);
} catch (e) {
  // If registry doesn't exist yet, gracefully fall back to empty
}

const publishedDate = new Date(article.data.published);
const publishedIso = publishedDate.toISOString().slice(0, 10);
const publishedHuman = publishedDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Calculate reading time from body text (220 wpm house standard)
const words = (article.body?.match(/\S+/g) ?? []).length;
const readingMinutes = Math.max(1, Math.round(words / 220));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: publishedIso,
  dateModified: article.data.updated ? new Date(article.data.updated).toISOString().slice(0, 10) : publishedIso,
  author: {
    "@type": "Person",
    name: "Luke",
    url: "https://lukethinks.nl/about",
  },
  mainEntityOfPage: `https://lukethinks.nl/articles/${article.data.slug}`,
  keywords: article.data.tags,
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.summary}
  canonical={`https://lukethinks.nl/articles/${article.data.slug}`}
  ogType="article"
  ogImage={`/assets/og/${article.data.slug}.png`}
  publishedTime={publishedIso}
  modifiedTime={article.data.updated ? new Date(article.data.updated).toISOString().slice(0, 10) : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <nav aria-label="Breadcrumb" class="breadcrumbs" slot="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/research">{article.data.category}</a></li>
        <li aria-current="page">{article.data.title}</li>
      </ol>
    </div>
  </nav>

  <article data-content-type="article" data-slug={article.data.slug} data-published={publishedIso}>
    <header class="article-header">
      <p class="article-meta">
        <span class="article-category">{article.data.category}</span>
        <time datetime={publishedIso}>{publishedHuman}</time>
        <span>{readingMinutes} min read</span>
        {article.data.confidence && (
          <span class="confidence-badge" data-confidence={article.data.confidence}>
            Confidence: {article.data.confidence}
          </span>
        )}
      </p>
      <h1 class="article-title">{article.data.title}</h1>
      {article.data.subtitle && <p class="article-subtitle">{article.data.subtitle}</p>}
    </header>

    {article.data.toc && headings.length > 0 && (
      <nav class="toc-container" aria-labelledby="toc-title" data-region="toc">
        <h2 class="toc-title" id="toc-title">On this page</h2>
        <ol class="toc-list">
          {headings.filter((h) => h.depth === 2).map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {companionAudio.length > 0 && (
      <CompanionAudioBanner
        audio={companionAudio}
        slug={article.data.slug}
        articleTitle={article.data.title}
      />
    )}

    <div class="article-content" data-region="body">
      <Content />
    </div>

    <footer class="article-footer">
      {article.data.sources && article.data.sources.length > 0 && (
        <>
          <h2 id="sources">Sources</h2>
          <ol>
            {article.data.sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></li>
            ))}
          </ol>
        </>
      )}

      <ReactionsBar slug={article.data.slug} server:defer>
        <div slot="fallback"></div>
      </ReactionsBar>

      {article.data.related && article.data.related.length > 0 && (
        <nav aria-labelledby="related-title" data-region="related">
          <h2 id="related-title">Related reading</h2>
          <ul>
            {article.data.related.map((relSlug) => (
              <li><a href={`/articles/${relSlug}`}>{relSlug}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </footer>
  </article>

  <!-- Client-side charts bundled locally via Chart.js -->
  <script>
    import Chart from 'chart.js/auto';

    function initCharts() {
      // Pricing Collapse Chart
      const pricingCanvas = document.getElementById('pricingChart') as HTMLCanvasElement | null;
      if (pricingCanvas && !pricingCanvas.dataset.rendered) {
        pricingCanvas.dataset.rendered = 'true';
        const ctx = pricingCanvas.getContext('2d');
        if (ctx) {
          new Chart(ctx, {
            type: 'line',
            data: {
              labels: ['Mar 2023', 'Jun 2023', 'Sep 2023', 'Dec 2023', 'Mar 2024', 'Jun 2024', 'Aug 2024'],
              datasets: [
                {
                  label: 'GPT-4 Output Tokens ($/Million)',
                  data: [60, 55, 45, 30, 20, 15, 10],
                  borderColor: 'rgba(146, 64, 14, 0.9)',
                  backgroundColor: 'rgba(146, 64, 14, 0.12)',
                  borderWidth: 3,
                  fill: true,
                  tension: 0.4,
                },
                {
                  label: 'Open-Source Equivalent ($/Million)',
                  data: [null, null, 20, 15, 10, 5, 1],
                  borderColor: 'rgba(234, 88, 12, 0.9)',
                  backgroundColor: 'rgba(234, 88, 12, 0.08)',
                  borderWidth: 3,
                  fill: true,
                  tension: 0.4,
                  borderDash: [5, 5],
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              aspectRatio: 2,
              plugins: {
                legend: {
                  display: true,
                  position: 'top',
                  labels: {
                    font: { family: 'Inter', size: 12, weight: '600' },
                    color: '#64748b',
                    usePointStyle: true,
                    padding: 16,
                  },
                },
                tooltip: {
                  callbacks: {
                    label: function (ctx) {
                      return `${ctx.dataset.label}: $${ctx.parsed.y}`;
                    },
                  },
                },
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: { color: 'rgba(146, 64, 14, 0.08)' },
                  ticks: {
                    color: '#64748b',
                    font: { family: 'Inter' },
                    callback: function (val) {
                      return '$' + val;
                    },
                  },
                  title: {
                    display: true,
                    text: 'Price per Million Tokens ($)',
                    color: '#64748b',
                    font: { family: 'Inter', weight: '600' },
                  },
                },
                x: {
                  grid: { display: false },
                  ticks: { color: '#64748b', font: { family: 'Inter' } },
                },
              },
            },
          });
        }
      }

      // Market Share Chart
      const marketShareCanvas = document.getElementById('marketShareChart') as HTMLCanvasElement | null;
      if (marketShareCanvas && !marketShareCanvas.dataset.rendered) {
        marketShareCanvas.dataset.rendered = 'true';
        const ctx = marketShareCanvas.getContext('2d');
        if (ctx) {
          new Chart(ctx, {
            type: 'bar',
            data: {
              labels: ['OpenAI', 'Anthropic', 'Google', 'Open Source'],
              datasets: [
                {
                  label: '2023 Share (%)',
                  data: [50, 15, 20, 5],
                  backgroundColor: 'rgba(146, 64, 14, 0.75)',
                  borderColor: 'rgba(146, 64, 14, 1)',
                  borderWidth: 2,
                  borderRadius: 8,
                },
                {
                  label: '2024 Share (%)',
                  data: [25, 32, 20, 13],
                  backgroundColor: 'rgba(234, 88, 12, 0.75)',
                  borderColor: 'rgba(234, 88, 12, 1)',
                  borderWidth: 2,
                  borderRadius: 8,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              aspectRatio: 2,
              plugins: {
                legend: {
                  display: true,
                  position: 'top',
                  labels: {
                    font: { family: 'Inter', size: 12, weight: '600' },
                    color: '#64748b',
                    usePointStyle: true,
                    padding: 16,
                  },
                },
                tooltip: {
                  callbacks: {
                    label: function (ctx) {
                      return `${ctx.dataset.label}: ${ctx.parsed.y}%`;
                    },
                  },
                },
              },
              scales: {
                y: {
                  beginAtZero: true,
                  max: 60,
                  grid: { color: 'rgba(146, 64, 14, 0.08)' },
                  ticks: {
                    color: '#64748b',
                    font: { family: 'Inter' },
                    callback: function (val) {
                      return val + '%';
                    },
                  },
                  title: {
                    display: true,
                    text: 'Enterprise AI Workload Share (%)',
                    color: '#64748b',
                    font: { family: 'Inter', weight: '600' },
                  },
                },
                x: {
                  grid: { display: false },
                  ticks: { color: '#64748b', font: { family: 'Inter' } },
                },
              },
            },
          });
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCharts);
    } else {
      initCharts();
    }
    document.addEventListener('astro:page-load', initCharts);
  </script>
</BaseLayout>
