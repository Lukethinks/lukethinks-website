---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Federal Reserve Board Composition & Rate Forecast"
  description="Interactive breakdown of the 7 Federal Reserve Board Governors, political affiliations, monetary policy stances (Hawk vs. Dove), and interest rate projection scenarios."
>
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/experiments">Experiments</a></li>
      <li aria-current="page">Fed Board Composition</li>
    </ol>
  </nav>

  <section class="experiment-hero">
    <div class="hero-badge">
      <span aria-hidden="true">🏛️</span>
      <span>Macroeconomic Modeling</span>
    </div>
    <h1>Federal Reserve Board <span class="hero-highlight">Composition</span></h1>
    <p class="hero-tagline">
      Political affiliations, monetary policy stances (Hawk vs. Dove), and interest rate projection scenarios across the Board of Governors.
    </p>
  </section>

  <div class="fed-app-layout">
    <!-- Chart Column -->
    <div class="fed-chart-card">
      <div class="chart-controls" role="group" aria-label="Chart view mode">
        <button type="button" class="view-btn is-active" id="btn-party" data-view="party">Political Affiliation</button>
        <button type="button" class="view-btn" id="btn-hawk" data-view="hawk">Hawk vs. Dove</button>
        <button type="button" class="view-btn" id="btn-rate" data-view="rate">Rate Forecast</button>
      </div>

      <div class="chart-canvas-container">
        <canvas id="fedChart"></canvas>
      </div>

      <div class="chart-caption" id="chartCaption">
        Showing breakdown of Federal Reserve Governors by nominating political party.
      </div>
    </div>

    <!-- Info Column -->
    <div class="fed-info-card">
      <div class="legend-box" id="legendBox">
        <h2 class="info-card-title">Definitions & Stances</h2>
        <div class="legend-entry">
          <span class="legend-term hawk">Hawk:</span>
          <span>Officials prioritizing price stability and lower inflation, typically leaning toward higher interest rates or delaying rate reductions.</span>
        </div>
        <div class="legend-entry">
          <span class="legend-term dove">Dove:</span>
          <span>Officials prioritizing employment and economic expansion, favoring lower borrowing costs and faster rate relief.</span>
        </div>
      </div>

      <!-- Rate Forecast Details (Visible when Rate Forecast is active) -->
      <div class="forecast-details is-hidden" id="rateForecastDetails">
        <h2 class="info-card-title">Projection Scenarios</h2>
        <div class="forecast-card consensus">
          <div class="forecast-card-title">Market Consensus Trajectory</div>
          <p class="forecast-card-text">
            Derived from the Fed dot plot, federal funds futures, and major investment bank projections (Goldman Sachs, J.P. Morgan, Morningstar).
          </p>
        </div>
        <div class="forecast-card scenario">
          <div class="forecast-card-title">Accelerated Easing Scenario</div>
          <p class="forecast-card-text">
            Modeled path if the Chair seat transitions in May 2026 to an aggressively dovish leadership team pushing for faster rate cuts.
          </p>
        </div>
        <div class="key-assumptions-box">
          <div class="assumptions-title">Baseline Assumptions:</div>
          <ul class="assumptions-list">
            <li>Baseline starting Fed Funds target: 4.25% – 4.50%</li>
            <li>Long-term neutral interest rate: ~2.50% – 3.00%</li>
            <li>Current Chair term expiration: May 2026</li>
          </ul>
        </div>
      </div>

      <!-- Members List -->
      <div class="members-section" id="membersSection">
        <h2 class="info-card-title">Current Board of Governors</h2>
        <div class="member-cards-list">
          <article class="gov-card republican">
            <div class="gov-header">
              <span class="gov-name">Jerome H. Powell</span>
              <span class="gov-party-badge rep">Republican</span>
            </div>
            <div class="gov-role">Chair</div>
            <div class="gov-details">Moderate Hawk · Board term ends 2028 (Chairmanship: May 2026)</div>
          </article>

          <article class="gov-card democrat">
            <div class="gov-header">
              <span class="gov-name">Philip N. Jefferson</span>
              <span class="gov-party-badge dem">Democrat</span>
            </div>
            <div class="gov-role">Vice Chair</div>
            <div class="gov-details">Moderate Dove · Board term ends 2036</div>
          </article>

          <article class="gov-card republican">
            <div class="gov-header">
              <span class="gov-name">Michelle W. Bowman</span>
              <span class="gov-party-badge rep">Republican</span>
            </div>
            <div class="gov-role">Vice Chair for Supervision</div>
            <div class="gov-details">Dove · Board term ends 2034</div>
          </article>

          <article class="gov-card democrat">
            <div class="gov-header">
              <span class="gov-name">Michael S. Barr</span>
              <span class="gov-party-badge dem">Democrat</span>
            </div>
            <div class="gov-role">Governor</div>
            <div class="gov-details">Moderate Dove · Board term ends 2032</div>
          </article>

          <article class="gov-card democrat">
            <div class="gov-header">
              <span class="gov-name">Lisa D. Cook</span>
              <span class="gov-party-badge dem">Democrat</span>
            </div>
            <div class="gov-role">Governor</div>
            <div class="gov-details">Moderate Dove · Board term ends 2038</div>
          </article>

          <article class="gov-card republican">
            <div class="gov-header">
              <span class="gov-name">Christopher J. Waller</span>
              <span class="gov-party-badge rep">Republican</span>
            </div>
            <div class="gov-role">Governor</div>
            <div class="gov-details">Dove · Board term ends 2030</div>
          </article>

          <article class="gov-card pending">
            <div class="gov-header">
              <span class="gov-name">Stephen Miran</span>
              <span class="gov-party-badge pending">Nominated</span>
            </div>
            <div class="gov-role">Governor (Pending Confirmation)</div>
            <div class="gov-details">Republican · Dove · Scheduled through 2026</div>
          </article>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { Chart, DoughnutController, LineController, ArcElement, LineElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend } from 'chart.js';
    Chart.register(DoughnutController, LineController, ArcElement, LineElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend);

    const canvas = document.getElementById('fedChart') as HTMLCanvasElement | null;
    const captionEl = document.getElementById('chartCaption');
    const legendBox = document.getElementById('legendBox');
    const forecastDetails = document.getElementById('rateForecastDetails');
    const membersSection = document.getElementById('membersSection');
    const buttons = document.querySelectorAll('.chart-controls .view-btn');

    let chartInstance: Chart | null = null;
    let activeView: 'party' | 'hawk' | 'rate' = 'party';

    const partyData = {
      labels: ['Republican Nominated', 'Democrat Nominated'],
      datasets: [{
        data: [3, 3],
        backgroundColor: ['#ea580c', '#3b82f6'],
        borderColor: '#ffffff',
        borderWidth: 2
      }]
    };

    const hawkDoveData = {
      labels: ['Hawks', 'Doves', 'Moderate Hawks', 'Moderate Doves'],
      datasets: [{
        data: [0, 2, 1, 3],
        backgroundColor: [
          '#b91c1c',
          '#10b981',
          '#f59e0b',
          '#34d399'
        ],
        borderColor: '#ffffff',
        borderWidth: 2
      }]
    };

    const rateData = {
      labels: ['Sep 25', 'Dec 25', 'Mar 26', 'Jun 26', 'Sep 26', 'Dec 26', 'Mar 27', 'Jun 27', 'Sep 27', 'Dec 27', 'Mar 28', 'Jun 28'],
      datasets: [
        {
          label: 'Market Consensus',
          data: [4.00, 3.75, 3.50, 3.25, 3.00, 3.00, 2.75, 2.50, 2.50, 2.25, 2.25, 2.25],
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: false,
          tension: 0.35,
          pointRadius: 4,
          pointHoverRadius: 6
        },
        {
          label: 'Accelerated Easing Scenario',
          data: [4.00, 3.75, 3.50, 3.00, 2.75, 2.50, 2.25, 2.00, 1.75, 1.75, 1.75, 2.00],
          borderColor: '#ea580c',
          backgroundColor: 'rgba(234, 88, 12, 0.1)',
          fill: false,
          tension: 0.35,
          borderDash: [5, 5],
          pointRadius: 4,
          pointHoverRadius: 6
        }
      ]
    };

    function renderView(view: 'party' | 'hawk' | 'rate') {
      if (!canvas) return;
      if (chartInstance) {
        chartInstance.destroy();
      }

      buttons.forEach(btn => {
        const isMatch = btn.getAttribute('data-view') === view;
        btn.classList.toggle('is-active', isMatch);
      });

      if (view === 'party') {
        if (captionEl) captionEl.textContent = 'Breakdown of current confirmed Governors by nominating political party.';
        if (forecastDetails) forecastDetails.classList.add('is-hidden');
        if (membersSection) membersSection.classList.remove('is-hidden');
        if (legendBox) legendBox.classList.remove('is-hidden');

        chartInstance = new Chart(canvas, {
          type: 'doughnut',
          data: partyData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { font: { family: 'Inter', size: 12, weight: 'bold' }, color: '#1e293b', padding: 16 }
              }
            }
          }
        });
      } else if (view === 'hawk') {
        if (captionEl) captionEl.textContent = 'Monetary policy leaning across the 6 current confirmed Governors.';
        if (forecastDetails) forecastDetails.classList.add('is-hidden');
        if (membersSection) membersSection.classList.remove('is-hidden');
        if (legendBox) legendBox.classList.remove('is-hidden');

        chartInstance = new Chart(canvas, {
          type: 'doughnut',
          data: hawkDoveData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { font: { family: 'Inter', size: 12, weight: 'bold' }, color: '#1e293b', padding: 16 }
              }
            }
          }
        });
      } else if (view === 'rate') {
        if (captionEl) captionEl.textContent = 'Projected Fed Funds Target Rate path: Market Consensus vs Accelerated Easing Scenario.';
        if (forecastDetails) forecastDetails.classList.remove('is-hidden');
        if (membersSection) membersSection.classList.add('is-hidden');
        if (legendBox) legendBox.classList.add('is-hidden');

        chartInstance = new Chart(canvas, {
          type: 'line',
          data: rateData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                min: 1.5,
                max: 4.5,
                ticks: {
                  callback: (val) => `${val}%`,
                  font: { family: 'Inter' },
                  color: '#64748b'
                },
                grid: { color: 'rgba(226, 232, 240, 0.8)' }
              },
              x: {
                ticks: { font: { family: 'Inter', size: 11 }, color: '#64748b' },
                grid: { display: false }
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
                labels: { font: { family: 'Inter', size: 12, weight: 'bold' }, color: '#1e293b', padding: 16 }
              },
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(2)}%`
                }
              }
            }
          }
        });
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view') as 'party' | 'hawk' | 'rate';
        if (view && view !== activeView) {
          activeView = view;
          renderView(activeView);
        }
      });
    });

    renderView('party');
  </script>
</BaseLayout>

<style>
  .breadcrumbs {
    padding: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    color: var(--light-text);
  }

  .breadcrumbs ol {
    display: flex;
    list-style: none;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .breadcrumbs li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: var(--border-light);
  }

  .breadcrumbs a {
    color: var(--primary-brown);
    text-decoration: none;
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--medium-text);
    font-weight: 600;
  }

  .experiment-hero {
    padding: 1.5rem 0 2rem;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(234, 88, 12, 0.1);
    color: var(--accent-amber);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(234, 88, 12, 0.2);
  }

  .hero-highlight {
    color: var(--accent-amber);
  }

  .hero-tagline {
    font-size: 1.1rem;
    color: var(--light-text);
    line-height: 1.6;
    margin-top: 0.75rem;
  }

  .fed-app-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
    align-items: start;
  }

  @media (max-width: 920px) {
    .fed-app-layout {
      grid-template-columns: 1fr;
    }
  }

  .fed-chart-card,
  .fed-info-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.85));
    border: 1px solid var(--border-light);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 4px 16px var(--shadow-light);
  }

  .chart-controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .view-btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 10px;
    border: 1px solid var(--border-light);
    background: white;
    color: var(--medium-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .view-btn:hover {
    border-color: var(--accent-amber);
    color: var(--accent-amber);
  }

  .view-btn.is-active {
    background: var(--accent-amber);
    color: white;
    border-color: var(--accent-amber);
  }

  .chart-canvas-container {
    position: relative;
    height: 380px;
    width: 100%;
    margin-bottom: 1rem;
  }

  .chart-caption {
    font-size: 0.85rem;
    color: var(--light-text);
    text-align: center;
    font-style: italic;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-light);
  }

  .info-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--dark-text);
    margin: 0 0 1rem;
  }

  .legend-box {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-light);
  }

  .legend-entry {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--medium-text);
    margin-bottom: 0.75rem;
  }

  .legend-term {
    font-weight: 800;
    margin-right: 0.35rem;
  }

  .legend-term.hawk {
    color: #b91c1c;
  }

  .legend-term.dove {
    color: #10b981;
  }

  .member-cards-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gov-card {
    background: white;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-light);
    border-left-width: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  .gov-card.republican {
    border-left-color: #ea580c;
  }

  .gov-card.democrat {
    border-left-color: #3b82f6;
  }

  .gov-card.pending {
    border-left-color: #94a3b8;
  }

  .gov-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.2rem;
  }

  .gov-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--dark-text);
  }

  .gov-party-badge {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .gov-party-badge.rep {
    background: rgba(234, 88, 12, 0.1);
    color: #c2410c;
  }

  .gov-party-badge.dem {
    background: rgba(59, 130, 246, 0.1);
    color: #2563eb;
  }

  .gov-party-badge.pending {
    background: rgba(148, 163, 184, 0.15);
    color: #475569;
  }

  .gov-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--light-text);
  }

  .gov-details {
    font-size: 0.775rem;
    color: var(--very-light-text);
    margin-top: 0.25rem;
  }

  .forecast-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .forecast-card {
    background: white;
    border-radius: 12px;
    padding: 1rem;
    border: 1px solid var(--border-light);
    border-left-width: 4px;
  }

  .forecast-card.consensus {
    border-left-color: #3b82f6;
  }

  .forecast-card.scenario {
    border-left-color: #ea580c;
  }

  .forecast-card-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--dark-text);
    margin-bottom: 0.35rem;
  }

  .forecast-card-text {
    font-size: 0.85rem;
    color: var(--light-text);
    margin: 0;
    line-height: 1.5;
  }

  .key-assumptions-box {
    background: rgba(248, 250, 252, 0.8);
    border-radius: 12px;
    padding: 1rem;
    border: 1px solid var(--border-light);
  }

  .assumptions-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--dark-text);
    margin-bottom: 0.5rem;
  }

  .assumptions-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.8rem;
    color: var(--medium-text);
    line-height: 1.6;
  }

  .is-hidden {
    display: none !important;
  }
</style>
