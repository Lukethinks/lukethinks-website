---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes', ({ data }) => data.status === 'published');
  return episodes.map((episode) => ({
    params: { slug: episode.data.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { data } = episode;
const { Content } = await render(episode);

const durationMinutes = Math.ceil(data.audio.durationSeconds / 60);
const publishedDate = new Date(data.published);
const formattedDate = publishedDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// Bi-directional link to companion articles
const companionArticleMap: Record<string, { title: string; href: string }> = {
  'the-50b-ai-partnership-bubble': {
    title: 'When Billion-Dollar AI Partnerships Meet Reality: A $50B Accounting Crisis in the Making',
    href: '/articles/ai-partnership-accounting',
  },
  'big-tech-ai-investments-the-great-accounting-debate': {
    title: 'When Billion-Dollar AI Partnerships Meet Reality: A $50B Accounting Crisis in the Making',
    href: '/articles/ai-partnership-accounting',
  },
};

const companionArticle = companionArticleMap[data.slug];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  name: data.title,
  description: data.summary,
  datePublished: publishedDate.toISOString().slice(0, 10),
  episodeNumber: data.episode,
  url: `https://lukethinks.nl/podcast/${data.slug}`,
  partOfSeries: {
    "@type": "PodcastSeries",
    name: "Luke Thinks",
    url: "https://lukethinks.nl/podcast",
  },
  associatedMedia: {
    "@type": "AudioObject",
    contentUrl: data.audio.src,
    encodingFormat: data.audio.mimeType || "audio/mpeg",
    duration: `PT${Math.round(data.audio.durationSeconds / 60)}M`,
  },
};
---

<BaseLayout
  title={`${data.title} · Episode ${data.episode}`}
  description={data.summary}
  ogType="article"
  publishedTime={publishedDate.toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/podcast">Podcast</a></li>
      <li aria-current="page">Episode {data.episode}</li>
    </ol>
  </nav>

  <article data-content-type="episode" data-slug={data.slug} data-episode={data.episode}>
    <header class="article-header">
      <div class="article-meta">
        <span class="article-category">Episode {data.episode}</span>
        {data.season && <span>Season {data.season}</span>}
        <time datetime={publishedDate.toISOString().slice(0, 10)}>{formattedDate}</time>
        <span>{durationMinutes} min</span>
        {data.confidence && (
          <span class="confidence-badge" data-confidence={data.confidence}>
            Confidence: {data.confidence}
          </span>
        )}
      </div>

      <h1 class="article-title">{data.title}</h1>
      <p class="article-subtitle">{data.summary}</p>
    </header>

    <!-- Governance AudioPlayer with speed controls and ARIA bindings -->
    <div class="episode-player-wrap">
      <AudioPlayer
        src={data.audio.src}
        title={`Listen to Episode ${data.episode}: ${data.title}`}
        id={`episode-${data.episode}`}
        durationSeconds={data.audio.durationSeconds}
        variant="episode"
        mimeType={data.audio.mimeType}
        headingLevel="h2"
        aiDisclosed={data.production?.aiDisclosed}
        disclosureText="Audio produced with AI voices. Written, directed and fact-checked by Luke."
        showSubscribe={true}
      />
    </div>

    <!-- Bi-directional Cross-Pollination Callout -->
    {companionArticle && (
      <aside class="callout companion-box" aria-labelledby="companion-title">
        <h2 class="callout-title" id="companion-title">📖 Companion Research Essay</h2>
        <p>
          This episode explores the forensic accounting mechanics detailed in our full written teardown:
          <a href={companionArticle.href} class="companion-link">
            {companionArticle.title} →
          </a>
        </p>
      </aside>
    )}

    <section class="article-content" aria-label="Show notes and breakdown">
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .episode-player-wrap {
    max-width: 860px;
    margin: 2rem auto 2.5rem;
  }

  .companion-box {
    max-width: 860px;
    margin: 0 auto 2.5rem;
    border-left: 4px solid var(--accent-amber);
    background: var(--surface-card-translucent);
  }

  .companion-link {
    font-weight: 700;
    color: var(--accent-amber);
    text-decoration: underline;
    margin-left: 0.25rem;
  }

  .companion-link:hover {
    color: var(--primary-brown);
  }
</style>
