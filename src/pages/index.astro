---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../../content/site.json';

const articles = await getCollection('articles', ({ data }) => data.status === 'published');
const sortedArticles = articles.sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());
---

<BaseLayout
  title={`${site.name} · ${site.tagline}`}
  description="Personal learning lab: where finance & FP&A analytical thinking meets hands-on exploration. Breaking down complex problems through data-driven insights."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span aria-hidden="true">📊</span>
        <span>Finance Professional • Personal Learning Lab</span>
      </div>

      <h1>
        Where I <span class="hero-highlight">figure things out</span>,<br />
        experiment with ideas,<br />
        and share discoveries
      </h1>

      <p class="hero-tagline">
        Finance & FP&A analytical thinking meets hands-on exploration. I break down complex problems,
        test hypotheses, and share the learning journey through data-driven insights.
      </p>

      <div class="hero-actions">
        <a href="/research" class="action-btn">Explore Research</a>
        <a href="/learning" class="action-btn secondary">Browse Learning</a>
      </div>

      <!-- Navigation Topic Cards -->
      <div class="topic-cards">
        <a href="/articles/ai-partnership-accounting" class="topic-card">
          <span class="topic-icon" aria-hidden="true">🤖</span>
          <h2 class="topic-title">AI Partnership Crisis</h2>
          <p class="topic-description">$50B accounting challenges when tech moves faster than standards</p>
          <span class="topic-count">Featured Analysis</span>
        </a>

        <a href="/podcast" class="topic-card">
          <span class="topic-icon" aria-hidden="true">🎙️</span>
          <h2 class="topic-title">Audio & Podcasts</h2>
          <p class="topic-description">Executive briefings, debates & financial autopsies (Spotify & Web)</p>
          <span class="topic-count">Podcast Hub</span>
        </a>

        <a href="/experiments" class="topic-card">
          <span class="topic-icon" aria-hidden="true">🚴</span>
          <h2 class="topic-title">Clothing Guides</h2>
          <p class="topic-description">Interactive tools: What to wear cycling and running in any weather</p>
          <span class="topic-count">Interactive Tool</span>
        </a>

        <a href="/about" class="topic-card">
          <span class="topic-icon" aria-hidden="true">👤</span>
          <h2 class="topic-title">About Luke</h2>
          <p class="topic-description">Finance professional in the Netherlands, analytical thinker, continuous learner.</p>
          <span class="topic-count">About Luke</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Analysis Section -->
  <section class="section-header">
    <h2 class="section-title">Latest Analysis</h2>
    <p class="section-subtitle">
      Recent financial models, business case studies, and data-driven insights from my learning lab
    </p>
  </section>

  <div class="topic-grid">
    {sortedArticles.map((article) => (
      <a href={`/articles/${article.data.slug}`} class="topic-card">
        <div class="article-meta">
          <span class="article-category">{article.data.category}</span>
          <time datetime={new Date(article.data.published).toISOString().slice(0, 10)}>
            {new Date(article.data.published).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
          {article.data.confidence && (
            <span class="confidence-badge" data-confidence={article.data.confidence}>
              {article.data.confidence}
            </span>
          )}
        </div>
        <h3 class="topic-title">{article.data.title}</h3>
        <p class="topic-description">{article.data.summary}</p>
        <span class="topic-count">Read Analysis →</span>
      </a>
    ))}
  </div>
</BaseLayout>
