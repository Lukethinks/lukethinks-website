---
import BaseLayout from '../layouts/BaseLayout.astro';
import LatestFeed from '../components/home/LatestFeed.astro';
import site from '../../content/site.json';
import { getLatest } from '../utils/latest';
import { getPodcast } from '../utils/episodes';
import { getWriting } from '../utils/writing';

const [latest, writing, { episodes, series }] = await Promise.all([getLatest(5), getWriting(), getPodcast()]);

const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const writingCount = plural(writing.length, 'piece');
const podcastCount =
  series.length > 0
    ? `${plural(episodes.length, 'episode')} · ${plural(series.length, 'series', 'series')}`
    : plural(episodes.length, 'episode');
---

<BaseLayout
  title={`${site.name} · ${site.tagline}`}
  description="A finance professional in the Netherlands working through accounting, AI and thinking frameworks in public: essays, a podcast and small experiments, with the thinking shown."
>
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span aria-hidden="true">📊</span>
        <span>Finance professional • Personal learning lab</span>
      </div>

      <h1>
        Where I <span class="hero-highlight">figure things out</span>,<br />
        experiment with ideas,<br />
        and share discoveries
      </h1>

      <p class="hero-tagline">
        I work in finance and FP&A in the Netherlands. This is where I work through accounting, AI and
        thinking frameworks in public, and publish the thinking, including the parts I get wrong.
      </p>

      <div class="hero-actions">
        <a href="/articles" class="action-btn">Read the writing</a>
        <a href="/podcast" class="action-btn secondary">Listen to the podcast</a>
      </div>
    </div>
  </section>

  <section class="section-header" aria-labelledby="latest-heading">
    <h2 class="section-title" id="latest-heading">What's new</h2>
    <p class="section-subtitle">The newest essays and podcast episodes, newest first</p>
  </section>

  <LatestFeed items={latest} />

  <section class="section-header" aria-labelledby="explore-heading">
    <h2 class="section-title" id="explore-heading">Explore</h2>
  </section>

  <div class="topic-cards">
    <a href="/articles" class="topic-card">
      <span class="topic-icon" aria-hidden="true">✍️</span>
      <h3 class="topic-title">Writing</h3>
      <p class="topic-description">Essays and analysis, each with its confidence level and sources.</p>
      <span class="topic-count">{writingCount}</span>
    </a>

    <a href="/podcast" class="topic-card">
      <span class="topic-icon" aria-hidden="true">🎙️</span>
      <h3 class="topic-title">Podcast</h3>
      <p class="topic-description">The same questions in audio: briefings, debates and a multi-part series.</p>
      <span class="topic-count">{podcastCount}</span>
    </a>

    <a href="/experiments" class="topic-card">
      <span class="topic-icon" aria-hidden="true">🧪</span>
      <h3 class="topic-title">Experiments</h3>
      <p class="topic-description">Interactive tools you can open and test: cycling and running kit guides, a Fed board explorer.</p>
      <span class="topic-count">Interactive tools</span>
    </a>

    <a href="/about" class="topic-card">
      <span class="topic-icon" aria-hidden="true">👤</span>
      <h3 class="topic-title">About</h3>
      <p class="topic-description">Who is writing this, and why.</p>
      <span class="topic-count">About Luke</span>
    </a>
  </div>
</BaseLayout>
