---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../../content/site.json';
import { resolveAudioUrl } from '../utils/audio';

const episodes = await getCollection('episodes', ({ data }) => data.status === 'published');
const sortedEpisodes = episodes.sort((a, b) => b.data.episode - a.data.episode);
---

<BaseLayout
  title="Audio Library & Podcasts"
  description="Executive audio briefings, deep debates, and financial analysis by Luke van den Top. Listen directly in your browser or stream on Spotify."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span aria-hidden="true">🎙️</span>
        <span>Executive Audio Briefings & Debates</span>
      </div>

      <h1>
        Audio Library & <span class="hero-highlight">Podcasts</span>
      </h1>

      <p class="hero-tagline">
        Executive briefings, deep analytical debates, and financial autopsies.
        Designed for listening on the go—stream directly in your browser or follow on Spotify.
      </p>

      <div class="platform-bar">
        <a href="https://open.spotify.com/search/Luke%20Thinks" class="platform-pill spotify" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">🟢</span>
          <span>Listen on Spotify</span>
        </a>
        <a href="/podcast.xml" class="platform-pill">
          <span aria-hidden="true">📡</span>
          <span>RSS Feed</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Episodes List -->
  <section class="section-header">
    <h2 class="section-title">All Episodes</h2>
    <p class="section-subtitle">
      Narrated summaries, point-counterpoint debates, and case study breakdowns
    </p>
  </section>

  <div class="episodes-container">
    {sortedEpisodes.map((ep) => {
      const minutes = Math.ceil(ep.data.audio.durationSeconds / 60);
      const playerTitleId = `player-title-${ep.data.slug}`;
      const pubDate = new Date(ep.data.published).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });

      return (
        <article class="episode-card">
          <div class="episode-card-header">
            <span class="episode-badge">Episode {ep.data.episode}</span>
            <time datetime={new Date(ep.data.published).toISOString().slice(0, 10)} class="episode-date">
              {pubDate}
            </time>
            <span class="episode-duration">⏱️ {minutes} min</span>
          </div>

          <h3 class="episode-title" id={playerTitleId}>
            <a href={`/podcast/${ep.data.slug}`}>{ep.data.title}</a>
          </h3>

          <p class="episode-summary">{ep.data.summary}</p>

          <div class="episode-player-row">
            <audio
              class="custom-audio-player"
              controls
              preload="none"
              aria-labelledby={playerTitleId}
            >
              <source src={resolveAudioUrl(ep.data.audio.src)} type={ep.data.audio.mimeType || 'audio/mpeg'} />
              <p>Your browser does not support audio playback.</p>
            </audio>
          </div>

          <div class="episode-card-footer">
            <a href={`/podcast/${ep.data.slug}`} class="episode-notes-link">
              View Episode & Show Notes →
            </a>
            <span class="ai-disclosure-badge">AI Disclosed</span>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>

<style>
  .platform-bar {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.5rem auto 2.5rem;
  }

  .platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.35rem;
    border-radius: 50px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    color: var(--dark-text);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    box-shadow: 0 2px 8px var(--shadow-light);
    transition: all 0.25s ease;
  }

  .platform-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px var(--shadow-medium);
  }

  .platform-pill.spotify {
    background: #121212;
    color: #ffffff;
    border-color: #121212;
  }

  .platform-pill.spotify:hover {
    background: #1db954;
    border-color: #1db954;
    color: #ffffff;
  }

  .episodes-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto 4rem;
  }

  .episode-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
    border-radius: 20px;
    padding: 2.25rem;
    border: 1px solid var(--border-light);
    box-shadow: 0 4px 20px var(--shadow-light);
    transition: all 0.3s ease;
  }

  .episode-card:hover {
    box-shadow: 0 8px 30px var(--shadow-medium);
    border-color: var(--accent-amber);
  }

  .episode-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  .episode-badge {
    background: rgba(146, 64, 14, 0.12);
    color: var(--primary-brown);
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .episode-date,
  .episode-duration {
    color: var(--light-text);
    font-weight: 500;
  }

  .episode-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--dark-text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .episode-title a {
    color: inherit;
    text-decoration: none;
  }

  .episode-title a:hover {
    color: var(--accent-amber);
  }

  .episode-summary {
    color: var(--light-text);
    font-size: 0.98rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .episode-player-row {
    margin-bottom: 1.5rem;
  }

  .custom-audio-player {
    width: 100%;
    height: 44px;
    display: block;
  }

  .episode-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
    font-size: 0.9rem;
  }

  .episode-notes-link {
    color: var(--accent-amber);
    font-weight: 700;
    text-decoration: none;
  }

  .episode-notes-link:hover {
    color: var(--primary-brown);
    text-decoration: underline;
  }

  .ai-disclosure-badge {
    font-size: 0.75rem;
    color: var(--light-text);
    background: #f1f5f9;
    padding: 0.25rem 0.65rem;
    border-radius: 12px;
    font-weight: 600;
  }
</style>
