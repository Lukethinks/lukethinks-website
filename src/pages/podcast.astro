---
import BaseLayout from '../layouts/BaseLayout.astro';
import podcast from '../../content/podcast.json';
import { getPodcast } from '../utils/episodes';
import PodcastSubscribe from '../components/podcast/PodcastSubscribe.astro';
import LatestEpisode from '../components/podcast/LatestEpisode.astro';
import PodcastSection from '../components/podcast/PodcastSection.astro';
import SeriesPanel from '../components/podcast/SeriesPanel.astro';
import EpisodeList from '../components/podcast/EpisodeList.astro';

// Page order answers three questions in turn: what is new, what belongs together,
// and what else is there. All of it is derived from content/episodes/*.md.
const { episodes, series } = await getPodcast();
const latest = episodes[0];
const episodeCount = `${episodes.length} episode${episodes.length === 1 ? '' : 's'}, newest first`;
---

<BaseLayout title="Podcast" description={podcast.description}>
  <section class="hero">
    <div class="hero-content">
      <h1>{podcast.title} <span class="hero-highlight">Podcast</span></h1>
      <p class="hero-tagline">{podcast.description}</p>
      <PodcastSubscribe />
    </div>
  </section>

  {latest ? (
    <>
      <LatestEpisode episode={latest} />

      {series.length > 0 && (
        <PodcastSection id="series" title="Series" note="Multi-part episodes, best heard in order">
          {series.map((s) => <SeriesPanel series={s} />)}
        </PodcastSection>
      )}

      <PodcastSection id="episodes" title="All episodes" note={episodeCount}>
        <EpisodeList episodes={episodes} />
      </PodcastSection>
    </>
  ) : (
    <p class="hero-tagline">The first episode is coming soon.</p>
  )}
</BaseLayout>
